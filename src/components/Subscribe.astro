---
import { BUTTONDOWN_USER } from '../consts.js';
const { headingLevel = 2 } = Astro.props;
const H = `h${headingLevel}`;
---
<section class="subscribe" aria-labelledby="subscribe-title">
  <H id="subscribe-title">Get each issue by email</H>
  <p>New notes, news and an album recommendation, straight to your inbox. Free, and you can unsubscribe anytime.</p>
  <form action={`https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USER}`} method="post">
    <label for="subscribe-email">Email address</label>
    <div class="row">
      <input id="subscribe-email" type="email" name="email" autocomplete="email" required />
      <input type="hidden" name="embed" value="1" />
      <button type="submit">Subscribe</button>
    </div>
  </form>
  <p class="fine">You will get a confirmation email first. Subscriptions are handled by Buttondown.</p>
</section>

<style>
  .subscribe { background: var(--notebook); color: #fff; padding: 2rem clamp(1.25rem, 4vw, 2.5rem); border-radius: 10px; }
  .subscribe :global(h2), .subscribe :global(h3) { color: #fff; margin-top: 0; }
  .subscribe p { max-width: 60ch; }
  label { display: block; font-weight: 700; margin-bottom: 0.4rem; }
  .row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  input[type='email'] { flex: 1 1 16rem; font: inherit; padding: 0.7rem 0.9rem; min-height: 48px; border: 2px solid #fff; border-radius: 6px; background: #fff; color: var(--ink); }
  button { font: inherit; font-weight: 800; padding: 0.7rem 1.4rem; min-height: 48px; border: 2px solid var(--highlight); background: var(--highlight); color: var(--ink); border-radius: 6px; cursor: pointer; }
  button:hover { background: #fff; border-color: #fff; }
  .subscribe :focus-visible { outline-color: var(--highlight); }
  .fine { font-size: var(--step--1); margin: 1rem 0 0; color: #ece6fb; }
</style>
