---
import { formatDate } from '../lib/issues.js';
import { webp } from '../lib/images.js';
const { issue, size = 'small', headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}`;
const big = size === 'large';
const w = webp(issue.cover);
// Displayed widths (measured): large card is full width below 56rem, then about half (max 35rem);
// small cards are 1–3 per row, at most about 23rem.
const sizes = big ? '(min-width: 56rem) min(47vw, 35rem), calc(100vw - 2rem)' : '(min-width: 72rem) 23rem, (min-width: 34rem) 45vw, calc(100vw - 2rem)';
---
<article class:list={['issue-card', { big }]}>
  <picture>
    {w && <source type="image/webp" srcset={w.srcset} sizes={sizes} />}
    <img src={issue.cover} alt="" width={w?.width ?? 1280} height={w?.height ?? 720} loading={big ? 'eager' : 'lazy'} fetchpriority={big ? 'high' : undefined} decoding="async" />
  </picture>
  <div class="text">
    <p class="date"><time datetime={issue.date}>{formatDate(issue.date)}</time></p>
    <H class="title"><a href={issue.url}>{issue.title}</a></H>
    {big && <p class="desc">{issue.description}</p>}
    {big && issue.album && (
      <p class="album">Created while listening: <a href={issue.album.url}>{issue.album.artist} – {issue.album.title}</a></p>
    )}
  </div>
</article>

<style>
  .issue-card { display: grid; gap: 1rem; align-content: start; }
  .issue-card img { width: 100%; border-radius: 8px; border: 1px solid var(--rule); }
  .date { margin: 0; color: var(--ink-soft); font-size: var(--step--1); }
  .title { margin: 0.2rem 0 0; font-size: 1.15rem; line-height: 1.3; }
  .title a { color: var(--ink); text-decoration-color: var(--rule); }
  .title a:hover { color: var(--notebook); text-decoration-color: currentColor; }

  /* The latest issue: a notebook page with ruled lines and a margin line */
  .big { grid-template-columns: 1fr; gap: 0; border: 2px solid var(--notebook); border-radius: 12px; overflow: hidden; background: var(--paper); }
  .big img { border: 0; border-radius: 0; }
  .big .text {
    padding: 1.5rem clamp(1.25rem, 4vw, 2.5rem) 1.75rem calc(clamp(1.25rem, 4vw, 2.5rem) + 1rem);
    background:
      linear-gradient(to right, transparent calc(clamp(1.25rem, 4vw, 2.5rem) - 0.1rem), var(--notebook) calc(clamp(1.25rem, 4vw, 2.5rem) - 0.1rem), var(--notebook) clamp(1.25rem, 4vw, 2.5rem), transparent clamp(1.25rem, 4vw, 2.5rem)),
      repeating-linear-gradient(to bottom, transparent 0 calc(1.9rem - 1px), #ebe5f8 calc(1.9rem - 1px) 1.9rem);
    line-height: 1.9rem;
  }
  .big .title { font-size: var(--step-2); line-height: 1.2; margin: 0.3rem 0 0.8rem; background: var(--paper); box-shadow: 0 0 0 0.35rem var(--paper); }
  .big .title a { text-decoration: none; }
  .big .title a:hover { text-decoration: underline; text-decoration-thickness: 0.08em; }
  .big .desc { font-size: var(--step-0); max-width: 60ch; margin: 0 0 0.8rem; }
  .big .album { margin: 0; color: var(--ink-soft); }
  @media (min-width: 56rem) {
    .big { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }
    .big img { height: 100%; object-fit: cover; }
  }
</style>
