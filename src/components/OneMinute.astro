---
// Home page "I have just 1 minute: What should I read?": one short piece from the latest issue (see getOneMinute).
// The running figure is decorative.
import { getOneMinute } from '../lib/issues.js';

const { issue, first = false } = Astro.props;
const pick = getOneMinute(issue);
---
{pick && (
  <section class:list={["one-minute", { first }]} aria-labelledby="one-minute-title">
    <span class="fig note-card"><img src="/images/figures/run.svg" alt="" width="719" height="621" /></span>
    <div class="body">
      <h2 id="one-minute-title" class="section-title chalk">I have just 1 minute: What should I read?</h2>
      <p class="meta">{pick.kind} · Notes # {pick.issue} · {pick.minutes} min read</p>
      <p class="title"><a href={pick.url}>{pick.title}</a></p>
      <p class="excerpt">{pick.excerpt}</p>
    </div>
  </section>
)}

<style>
  .one-minute { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 1.5rem 2rem; align-items: center; margin-top: 3.5rem; }
  .one-minute.first { margin-top: 0; }
  .body .section-title { font-size: var(--step-1); margin: 0 0 1rem; }
  .meta { margin: 0 0 0.25rem; font-size: var(--step--1); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-soft); }
  .title { margin: 0 0 0.4rem; font-size: var(--step-1); font-weight: 800; line-height: 1.25; }
  .excerpt { margin: 0; max-width: 60ch; }
  @media (max-width: 40rem) {
    /* phones: figure beside the heading, the pick below at full width */
    .one-minute { grid-template-columns: 7.5rem minmax(0, 1fr); gap: 0 1.25rem; }
    .body { display: contents; }
    .body .section-title { margin: 0; align-self: center; }
    .fig { padding: 0.6rem 0.5rem 0.5rem; }
    .meta { margin-top: 1rem; }
    .meta, .title, .excerpt { grid-column: 1 / -1; }
  }
</style>
