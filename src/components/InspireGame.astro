---
// Inspirations header game: hangman in reverse. Every inspiration the reader opens draws one more
// part of a stick figure; at five he is done and cheers. Progress lives in this browser only.
// Shown only with JavaScript; the figure itself is decorative, the score line is real text.
import fs from 'node:fs';
const figure = fs.readFileSync('src/assets/inspire-figure.svg', 'utf8');
---
<div class="inspire note-card" hidden>
  <div class="stage" set:html={figure} />
  <p class="msg" aria-live="polite" tabindex="-1">Open one, I'll draw a line.</p>
  <button type="button" class="again" hidden>Draw him again</button>
</div>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('.inspire')];
  if (cards.length) {
    const KEY = 'inspired', SEEN = 'inspired-seen', GOAL = 5;
    const read = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
    const write = (k: string, v: string | null) => { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch {} };
    let opened: string[] = [];
    try { opened = JSON.parse(read(KEY) || '[]'); } catch {}

    const show = (animateFrom: number) => {
      const n = Math.min(opened.length, GOAL);
      const finished = n >= GOAL;
      for (const card of cards) {
      const parts = [...card.querySelectorAll<SVGGElement>('.part')];
      const done = card.querySelector<SVGGElement>('.done')!;
      const ghost = card.querySelector<SVGGElement>('.ghost')!;
      const msg = card.querySelector<HTMLElement>('.msg')!;
      const again = card.querySelector<HTMLButtonElement>('.again')!;
      parts.forEach((p, i) => {
        p.style.display = !finished && i < n ? '' : 'none';
        p.classList.toggle('new', i >= animateFrom && i < n);
      });
      done.style.display = finished ? '' : 'none';
      ghost.style.display = finished ? 'none' : '';
      card.classList.toggle('finished', finished);
      card.classList.toggle('cheer', finished && animateFrom < GOAL);
      msg.textContent = finished ? 'Five! He’s inspired. Your turn.'
        : n === 0 ? 'Open one, I’ll draw a line.'
        : `${n} of 5 opened. Keep going.`;
      again.hidden = !finished;
      }
      write(SEEN, String(n));
    };

    for (const card of cards) card.hidden = false;
    show(Number(read(SEEN) || 0));

    const count = (e: Event) => {
      const a = (e.target as Element).closest('.item h3 a');
      if (!a) return;
      const id = a.closest('.item')!.getAttribute('aria-labelledby')!;
      if (opened.includes(id) || opened.length >= GOAL) return;
      const before = opened.length;
      opened.push(id);
      write(KEY, JSON.stringify(opened));
      show(before);
    };
    document.addEventListener('click', count);
    document.addEventListener('auxclick', count);
    for (const card of cards) {
      card.querySelector('.again')!.addEventListener('click', () => { opened = []; write(KEY, null); show(0); card.querySelector<HTMLElement>('.msg')!.focus(); });
    }
  }
</script>

<style>
  .inspire { text-align: center; }
  .stage :global(svg) { display: block; width: 100%; height: auto; overflow: visible; }
  .stage :global(.f) { fill: #2d0a72; stroke: none; }
  .stage :global(.ground) { opacity: 0.55; }
  .stage :global(.ghost) { stroke: #b9aee0; }
  .msg:focus { outline: none; }
  .msg:focus-visible { outline: 3px solid var(--notebook); outline-offset: 2px; }
  .msg { margin: 0.4rem 0 0; font-size: 0.95rem; font-weight: 700; line-height: 1.3; }
  .again { margin-top: 0.35rem; font: inherit; font-size: 0.95rem; font-weight: 700; color: var(--notebook); background: none; border: 0; padding: 0 0.25rem; min-height: 44px; text-decoration: underline; text-underline-offset: 0.18em; cursor: pointer; }
  @media (prefers-reduced-motion: no-preference) {
    .stage :global(.part.new) { animation: pop 0.5s cubic-bezier(.3, 1.6, .5, 1) both; transform-box: fill-box; transform-origin: center; }
    .stage :global(.part.new:nth-child(n)) { animation-delay: 0.25s; }
    .cheer .stage :global(.done) { animation: hop 0.6s ease-out 0.2s 2 both; transform-box: fill-box; transform-origin: bottom; }
    .cheer .stage :global(.spark) { animation: twinkle 1.2s ease-out 0.2s both; transform-box: fill-box; transform-origin: center; }
  }
  @keyframes pop { from { opacity: 0; transform: scale(0.6); } to { opacity: 1; transform: none; } }
  @keyframes hop { 0%, 100% { transform: none; } 40% { transform: translateY(-14%); } }
  @keyframes twinkle { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: none; } }
  @media (forced-colors: active) { .stage :global(svg) { stroke: CanvasText; } .stage :global(.f) { fill: CanvasText; } }
</style>
