---
const links = [
  { href: '/originals/', label: 'Originals' },
  { href: '/news/', label: 'News' },
  { href: '/inspirations/', label: 'Inspirations' },
  { href: '/notes/', label: 'Full Issues' },
  { href: '/about/', label: 'About Me' },
];
const path = Astro.url.pathname;
const isCurrent = (href) => path === href;
const inSection = (href) => path.startsWith(href) && path !== href;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <img src="/logo.png" alt="" width="48" height="47" />
      <span>Accessibility Notebook</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : inSection(l.href) ? 'true' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 2px solid var(--rule); background: var(--paper); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 2rem; padding-block: 1rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--notebook); text-decoration: none; font-weight: 800; font-size: 1.35rem; letter-spacing: -0.01em; }
  .brand:hover span { text-decoration: underline; text-decoration-thickness: 0.1em; text-underline-offset: 0.2em; }
  nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem 0.4rem; list-style: none; margin: 0; padding: 0; }
  nav li + li { margin-top: 0; }
  nav a { display: inline-block; padding: 0.55rem 0.75rem; min-height: 44px; color: var(--ink); text-decoration: none; font-weight: 700; border-radius: 6px; }
  nav a:hover { background: var(--tint); }
  nav a[aria-current] { color: var(--notebook); box-shadow: inset 0 -3px 0 var(--notebook); border-radius: 6px 6px 0 0; }
</style>
