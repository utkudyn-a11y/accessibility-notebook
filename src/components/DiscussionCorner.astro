---
import '../styles/question.css';
// Discussion Corner: one random question at a time from the "discussion" list in each issue's
// front matter, with a vote. There is deliberately no page that lists every question.
// Votes are stored by the Pages Function in functions/api/votes.js.
import { getIssues, formatDateLong, isNewIssue } from '../lib/issues.js';
import { discussionId } from '../lib/discussion.js';

const { headingLevel = 2 } = Astro.props;
const H = `h${headingLevel}`;

const questions = getIssues().flatMap((i) =>
  (i.discussion || []).map((d, k) => ({
    id: discussionId(i.number, d, k),
    n: i.number,
    date: i.date,
    dateText: formatDateLong(i.date),
    issue: d.sourceUrl,
    comments: `${i.url}#comments`,
    context: d.context,
    question: d.question,
    options: d.options || [],
    isNew: isNewIssue(i.number),
  }))
);
// Without JavaScript, readers see the latest issue's question (no vote).
const first = questions[0];
---
{first && (
  <section class="dc" aria-labelledby="dc-title" data-questions={JSON.stringify(questions)}>
    <H id="dc-title">Discussion Corner</H>
    <p class="intro">Every issue raises a question worth arguing about. Read it, pick a side and tell me why in the comments of the issue.</p>

    <div class="q">
      <span class="q-mark" aria-hidden="true">?</span>
      <div class="q-body">
        <p class="over">From Notes # {first.n} on <time datetime={first.date}>{first.dateText}</time>{first.isNew && <span class="new"> New</span>}</p>
        <p class="context">{first.context}</p>
        <p class="ask">{first.question}</p>
        <p class="links">
          <a href={first.comments}>Comment On Notes # {first.n}</a>
          <a href={first.issue}>Read Notes # {first.n}</a>
        </p>
      </div>
    </div>

    <button type="button" class="another" hidden>Show another question</button>
    <p class="visually-hidden dc-status" aria-live="polite"></p>

    <details class="all">
      <summary>See all {questions.length} questions</summary>
      <ol>
        {questions.map((q) => (
          <li><a class="pick" href={`/?question=${q.id}#dc-title`} data-id={q.id}>{q.question}</a>{q.isNew && <span class="new"> New</span>} <span class="from">Notes # {q.n}</span></li>
        ))}
      </ol>
    </details>
  </section>
)}

<script>
  import { createVoter, esc, type Q } from '../scripts/vote.ts';
  const root = document.querySelector<HTMLElement>('.dc');
  if (root) {
    const all: Q[] = JSON.parse(root.dataset.questions || '[]');
    const body = root.querySelector<HTMLElement>('.q-body')!;
    const another = root.querySelector<HTMLButtonElement>('.another')!;
    const status = root.querySelector<HTMLElement>('.dc-status')!;
    // "Comment On Notes # N" points to the comments at the end of the issue page.
    const { show } = createVoter(body, {
      over: (q) => `From Notes # ${q.n} on <time datetime="${esc(q.date)}">${esc(q.dateText)}</time>${q.isNew ? '<span class="new"> New</span>' : ''}`,
      commentLink: (q) => `<a href="${esc(q.comments)}">Comment On Notes # ${q.n}</a>`,
      readLink: (q) => `<a href="${esc(q.issue)}">Read Notes # ${q.n}</a>`,
    });

    // Shuffled deck: every question comes up once before any repeats.
    let deck: number[] = [];
    let last = -1;
    const next = () => {
      if (!deck.length) {
        deck = all.map((_, i) => i);
        for (let i = deck.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [deck[i], deck[j]] = [deck[j], deck[i]];
        }
        if (deck.length > 1 && deck[deck.length - 1] === last) deck.unshift(deck.pop()!);
      }
      last = deck.pop()!;
      return all[last];
    };

    if (all.length) {
      // A link from search (/?question=6-1) opens that question; otherwise a surprise question.
      const asked = new URL(location.href).searchParams.get('question');
      const pick = all.findIndex((q) => q.id === asked);
      if (pick >= 0) {
        last = pick;
        show(all[pick]);
      } else {
        show(next());
      }
      // "See all questions": open the chosen question in the card above instead of reloading the page.
      root.querySelectorAll<HTMLAnchorElement>('.all a.pick').forEach((a) => a.addEventListener('click', (e) => {
        const i = all.findIndex((q) => q.id === a.dataset.id);
        if (i < 0) return;
        e.preventDefault();
        last = i;
        show(all[i]);
        try { history.replaceState(null, '', `/?question=${encodeURIComponent(all[i].id)}#dc-title`); } catch {}
        body.setAttribute('tabindex', '-1');
        body.focus({ preventScroll: true });
        root.querySelector('#dc-title')!.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }));
      if (all.length > 1) {
        another.hidden = false;
        another.addEventListener('click', () => {
          const q = next();
          show(q);
          status.textContent = `New question from Notes # ${q.n}: ${q.question}`;
        });
      }
    }
  }
</script>

<style>
  .dc { margin-top: 4rem; }
  .dc h2, .dc h3 { font-size: var(--step-1); margin: 0 0 0.5rem; }
  .intro { max-width: 60ch; }
  .all { margin-top: 1.5rem; max-width: 44rem; }
  .all summary { cursor: pointer; font-weight: 700; color: var(--notebook); min-height: 44px; padding: 0.6rem 0; width: fit-content; }
  .all ol { padding-left: 2.2rem; margin: 0.75rem 0 0; }
  .all li { margin: 0 0 0.8rem; }
  .all a { font-weight: 700; }
  .all .from { display: block; font-size: var(--step--1); color: var(--ink-soft); }
  .another { font: inherit; font-weight: 800; padding: 0.7rem 1.6rem; min-height: 48px; border: 2px solid var(--notebook); background: #fff; color: var(--notebook); border-radius: 6px; cursor: pointer; }
  .another:hover { background: var(--notebook); color: #fff; }
</style>
