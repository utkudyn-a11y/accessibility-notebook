---
// "Read while listening": a random pick from the "Created While Listening" line of every issue.
// The record sleeve is decorative; the button, the result text and the full album list carry the content.
import { getIssues } from '../lib/issues.js';

const { headingLevel = 2 } = Astro.props;
const H = `h${headingLevel}`;

const albums = getIssues()
  .filter((i) => i.album?.title)
  .map((i) => ({ n: i.number, artist: i.album.artist, title: i.album.title, url: i.album.url, issue: i.url }));
---
<section class="spin" aria-labelledby="spin-title" data-albums={JSON.stringify(albums)}>
  <H id="spin-title">Read while listening</H>
  <p class="intro">Every issue of Accessibility Notebook is written while listening to an album. These are the albums from the "Created While Listening" line of each issue. Press the button and find your next one.</p>

  <button type="button" class="pick" hidden>Pick an album</button>
  <div class="result" aria-live="polite"></div>

  <details class="all">
    <summary>See all {albums.length} albums</summary>
    <ul>
      {albums.map((a) => (
        <li>
          <span class="t">{a.title}</span> by {a.artist}
          <span class="links"><a href={a.url}>Listen on Spotify<span class="visually-hidden">: {a.title}</span></a> · <a href={a.issue}>Notes # {a.n}</a></span>
        </li>
      ))}
    </ul>
  </details>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.spin');
  if (root) {
    const albums: { n: number; artist: string; title: string; url: string; issue: string }[] = JSON.parse(root.dataset.albums || '[]');
    const button = root.querySelector<HTMLButtonElement>('.pick')!;
    const result = root.querySelector<HTMLElement>('.result')!;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    let last = -1;

    button.hidden = false;
    button.addEventListener('click', () => {
      let i = Math.floor(Math.random() * albums.length);
      if (albums.length > 1 && i === last) i = (i + 1 + Math.floor(Math.random() * (albums.length - 1))) % albums.length;
      last = i;
      const a = albums[i];
      result.innerHTML =
        `<div class="card">` +
          `<div class="sleeve" aria-hidden="true"><div class="disc"></div><div class="cover"><span><small>NOTES</small># ${a.n}</span></div></div>` +
          `<div class="text">` +
            `<p class="over">From Notes # ${a.n}</p>` +
            `<p class="album">${esc(a.title)}</p>` +
            `<p class="artist">by ${esc(a.artist)}</p>` +
            `<p class="links"><a href="${esc(a.url)}">Listen on Spotify<span class="visually-hidden">: ${esc(a.title)}</span></a>` +
            `<a href="${esc(a.issue)}">Read Notes # ${a.n}</a></p>` +
          `</div>` +
        `</div>`;
    });
  }
</script>

<style>
  .spin { margin-top: 4rem; }
  .spin h2, .spin h3 { font-size: var(--step-1); margin: 0 0 0.5rem; }
  .intro { max-width: 60ch; }
  .pick { font: inherit; font-weight: 800; padding: 0.7rem 1.6rem; min-height: 48px; border: 2px solid var(--notebook); background: var(--notebook); color: #fff; border-radius: 6px; cursor: pointer; margin-top: 0.5rem; }
  .pick:hover { background: #fff; color: var(--notebook); }

  .result:empty { display: none; }
  .result :global(.card) { margin-top: 1.5rem; max-width: 40rem; display: grid; grid-template-columns: 10.5rem minmax(0, 1fr); gap: 1.25rem; align-items: center; background: var(--tint); border-radius: 10px; padding: 1.25rem; animation: card-in 0.35s ease-out; }
  .result :global(.sleeve) { position: relative; width: 8.5rem; aspect-ratio: 1; }
  .result :global(.disc) { position: absolute; inset: 6% -18% 6% 30%; border-radius: 50%; background: radial-gradient(circle, var(--highlight) 0 14%, var(--ink) 15% 100%); box-shadow: inset 0 0 0 6px #2a2242, inset 0 0 0 14px var(--ink), inset 0 0 0 15px #3a3152; animation: disc-out 0.6s ease-out; }
  .result :global(.cover) { position: absolute; inset: 0; background: var(--notebook); border-radius: 4px; display: grid; place-items: center; color: #fff; font-weight: 800; font-size: 1.6rem; text-align: center; }
  .result :global(.cover small) { display: block; font-size: 0.75rem; letter-spacing: 0.08em; font-weight: 700; color: #e4dcfa; }
  .result :global(p) { margin: 0; }
  .result :global(.over) { font-size: var(--step--1); color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 700; margin-bottom: 0.3rem; }
  .result :global(.album) { font-size: var(--step-1); font-weight: 800; line-height: 1.2; }
  .result :global(.artist) { margin: 0.2rem 0 0.6rem; }
  .result :global(.links) { display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  .result :global(.links a) { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; }
  @media (max-width: 30rem) {
    .result :global(.card) { grid-template-columns: minmax(0, 1fr); }
    .result :global(.sleeve) { width: 6.5rem; margin-bottom: 0.25rem; }
  }
  @keyframes card-in { from { opacity: 0; transform: translateY(6px); } }
  @keyframes disc-out { from { transform: translateX(-30%) rotate(-90deg); } }

  .all { margin-top: 1.5rem; }
  .all summary { cursor: pointer; font-weight: 700; color: var(--notebook); min-height: 44px; padding: 0.6rem 0; width: fit-content; }
  .all ul { padding-left: 1.25rem; columns: 2 22rem; column-gap: 2.5rem; margin-top: 0.75rem; }
  .all li { break-inside: avoid; margin: 0 0 0.6rem; }
  .all .t { font-weight: 700; }
  .all .links { display: block; font-size: var(--step--1); line-height: 2; }
</style>
