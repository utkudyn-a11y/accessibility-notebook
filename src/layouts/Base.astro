---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
// Preloading the fonts lets text appear in its final font right away, so the page does not jump when they load.
import font400 from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url';
import font700 from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-700-normal.woff2?url';
import font800 from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-800-normal.woff2?url';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, AUTHOR, CF_ANALYTICS_TOKEN } from '../consts.js';

const {
  title,
  description = SITE_DESCRIPTION,
  image = '/images/site-og.png',
  type = 'website',
  published,
  jsonLd,
  noindex = false,
} = Astro.props;
// No back-to-top button on issue and article pages, so it never covers the text being read
const backToTop = type !== 'article' && !noindex;

const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
const imageUrl = new URL(image, Astro.site ?? SITE_URL).href;
const ld = jsonLd ?? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: new URL('/', Astro.site ?? SITE_URL).href,
  description: SITE_DESCRIPTION,
  author: { '@type': 'Person', name: AUTHOR.name },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {[font400, font700, font800].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content="nFoONTGjqrizseo2bnZlKl4eiDIJh38K30A4mIdDDoM" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#2d0a72" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <script is:inline>
      // Paper sheets are thrown in on the first page of a visit (once per page per session); never with reduced motion.
      // Runs in the head so the sheets never flash before the animation.
      (function () {
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
          // Moving between pages of the site has its own page turn, so sheets are thrown only where a visit starts
          if (document.referrer && new URL(document.referrer).origin === location.origin) return;
          var k = 'thrown:' + location.pathname;
          if (sessionStorage.getItem(k)) return;
          sessionStorage.setItem(k, '1');
          document.documentElement.classList.add('throw-on');
        } catch (e) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {CF_ANALYTICS_TOKEN && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {backToTop && <BackToTop />}
    <script>
      // Sheets land as they scroll into view; the ones arriving together come one after another
      if (document.documentElement.classList.contains('throw-on')) {
        const io = new IntersectionObserver((entries) => {
          let k = 0;
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.style.setProperty('--d', `${k++ * 160}ms`);
            el.classList.add('landed');
            io.unobserve(el);
          }
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.sheet').forEach((s) => io.observe(s));
      }
    </script>
  </body>
</html>
