---
import Base from '../../layouts/Base.astro';
import { getIssues, formatDate } from '../../lib/issues.js';
const issues = getIssues();
// Square, text-free crop of each cover's drawing (made by scripts/cover-squares.py)
// Milestone strips between issues: shown just after (below) the issue they belong to
const MILESTONES = {
  28: { fig: 'ms-home', w: 542, h: 535, text: 'Accessibility Notebook got its own home.' },
  17: { fig: 'ms-design', w: 372, h: 485, text: 'I finally learned to design something.' },
  1: { fig: 'ms-start', w: 541, h: 532, text: 'It all started here.' },
};
const monthYear = (d) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
// the list is split at each milestone, so a strip is never read as an issue
const chunks = [];
let open = null;
for (const i of issues) {
  if (!open) chunks.push(open = { issues: [] });
  open.issues.push(i);
  if (MILESTONES[i.number]) { open.milestone = { ...MILESTONES[i.number], date: i.date }; open = null; }
}
const square = (n, small = false) => `/images/squares/notes-${String(n).padStart(2, '0')}${small ? '-320' : ''}.webp`;
// phones show the square at 6.5rem, so they get the 320 px file; the grid cards get 640 px
const SIZES = '(max-width: 40rem) 6.5rem, (max-width: 64rem) 45vw, 21rem';
---
<Base title="Full Issues" description="Every issue of Accessibility Notebook.">
  <div class="wrap page">
    <div class="sheet head">
    <h1>Full Issues</h1>
    <span class="fig note-card"><img src="/images/figures/issues-stack.svg" alt="" width="421" height="548" /></span>
    <p class="lead reading">Every issue of Accessibility Notebook. Each one has personal notes, accessibility news, inspirations and usually an in-depth article.</p>
    </div>
    <div class="sheet">
    {chunks.map((c, ci) => (<>
    <ol class="issues" start={c.issues[0].number} reversed>
      {c.issues.map((i, k) => (
        <li>
          <article class="issue" aria-labelledby={`i-${i.number}`}>
            <img src={square(i.number)} srcset={`${square(i.number, true)} 320w, ${square(i.number)} 640w`} sizes={SIZES} alt="" width="640" height="640" loading={ci === 0 && k < 6 ? 'eager' : 'lazy'} decoding="async" />
            <div class="text">
              <p class="meta"><time datetime={i.date}>{formatDate(i.date)}</time></p>
              <h2 id={`i-${i.number}`}><a href={i.url}>{i.title}</a></h2>
              <p class="desc">{i.description}</p>
            </div>
          </article>
        </li>
      ))}
    </ol>
    {c.milestone && (
      <aside class="milestone" aria-label={`Milestone, ${monthYear(c.milestone.date)}`}>
        <span class="fig note-card"><img src={`/images/figures/${c.milestone.fig}.svg`} alt="" width={c.milestone.w} height={c.milestone.h} loading="lazy" /></span>
        <p><time datetime={c.milestone.date}>{monthYear(c.milestone.date)}</time> <span class="say">{c.milestone.text}</span></p>
      </aside>
    )}
    </>))}
    </div>
  </div>
</Base>
<style>
  .page { padding-top: 2.5rem; }
  .lead { font-size: var(--step-1); line-height: 1.45; }
  .head { display: flow-root; }
  .head .fig { float: right; width: 8.5rem; margin: -4.75rem 0.5rem 0 2rem; }
  @media (min-width: 40.01rem) { .head h1 { margin-right: 11rem; } }
  @media (max-width: 40rem) { .head .fig { width: 5.5rem; margin: 0.4rem 0 0.5rem 0.9rem; padding: 0.5rem 0.4rem 0.4rem; } }

  .issues { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 40.01rem) { .issues { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .issues { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .issues li + li { margin-top: 0; }
  .issue { position: relative; height: 100%; display: flex; flex-direction: column; background: #fff; border: 2px solid var(--rule); border-radius: 10px; overflow: hidden; }
  .issue:hover { border-color: var(--notebook); }
  .issue img { display: block; width: 100%; height: auto; aspect-ratio: 1; background: #2d0a72; }
  .text { padding: 1rem 1.15rem 1.2rem; }
  .meta { margin: 0 0 0.35rem; font-size: var(--step--1); color: var(--ink-soft); }
  .issue h2 { font-size: 1.15rem; line-height: 1.3; margin: 0 0 0.5rem; overflow-wrap: anywhere; }
  .issue h2 a { color: var(--ink); }
  .issue h2 a:hover { color: var(--notebook); }
  .desc { margin: 0; font-size: 1rem; }
  /* phones: the square sits beside the text */
  @media (max-width: 40rem) {
    .issue { flex-direction: row; align-items: flex-start; }
    .issue img { width: 6.5rem; flex: none; margin: 1rem 0 1rem 1rem; border-radius: 6px; }
    .text { padding: 0.9rem 1rem 1rem; }
  }
  .milestone { display: flex; align-items: center; gap: 1.5rem; margin: 2.25rem 0; padding: 1.25rem 0; border-block: 2px dashed var(--notebook); }
  .milestone .fig { flex: none; width: 7rem; }
  .milestone p { margin: 0; display: flex; flex-direction: column; gap: 0.2rem; }
  .milestone time { font-size: var(--step--1); font-weight: 700; color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.04em; }
  .say { font-size: var(--step-2); font-weight: 800; line-height: 1.2; color: var(--notebook); }
  @media (max-width: 40rem) { .milestone { gap: 1rem; } .milestone .fig { width: 5rem; padding: 0.5rem 0.4rem 0.4rem; } .say { font-size: var(--step-1); } }
  @media (forced-colors: active) { .issue { border-color: CanvasText; } }
</style>
