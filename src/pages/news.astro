---
import Base from '../layouts/Base.astro';
import { getIssues, plainText, formatDateLong } from '../lib/issues.js';

// Every story, dated by its original publication date (or the issue date when that is unknown),
// grouped by month, newest month and newest story first.
const items = getIssues()
  .flatMap((i) => i.news.map((it) => ({ ...it, issueUrl: i.url, when: it.published || i.date })))
  .sort((a, b) => b.when.localeCompare(a.when) || b.issue - a.issue);

const months = [];
for (const it of items) {
  const key = it.when.slice(0, 7);
  let m = months.at(-1);
  if (!m || m.key !== key) {
    m = { key, label: new Date(`${key}-15T12:00:00Z`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }), items: [] };
    months.push(m);
  }
  m.items.push(it);
}

// Month header pieces (decorative, hand-drawn, one colour): a desk-calendar sheet and tally marks for the story count
const C = '#2d0a72';
const calendar = `<svg viewBox="0 0 64 70" aria-hidden="true" focusable="false" fill="none" stroke="${C}" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5,13 Q6,12.5 7,11.2 L56.6,10.6 Q58.6,11 58.2,13.4 L58.8,63.6 Q58.4,66.2 55.8,65.9 L8.6,66.4 Q6.4,66.1 6.6,63.8 Z" fill="#fff" stroke-width="2.6"/><path d="M7.2,25.6 Q30,24.6 58.4,25.2" stroke-width="2"/><path d="M20.5,3.5 L20.3,14 M43.8,3.3 L44,14.2" stroke-width="3.6"/></svg>`;
const tally = (n) => {
  let d = '', x = 2;
  const j = (k) => (Math.sin(n * 7.3 + k * 2.1) * 0.9).toFixed(1);
  for (let g = 0; g < Math.ceil(n / 5); g++) {
    const inGroup = Math.min(5, n - g * 5);
    for (let k = 0; k < Math.min(4, inGroup); k++) d += `M${(x + k * 6 + +j(k)).toFixed(1)},3 L${(x + k * 6 - +j(k + 1)).toFixed(1)},21 `;
    if (inGroup === 5) d += `M${x - 3},16 L${x + 22},7 `;
    x += 32;
  }
  return `<svg viewBox="0 0 ${x - 4} 24" width="${(x - 4) * 0.8}" height="19" aria-hidden="true" focusable="false" fill="none" stroke="${C}" stroke-width="2.4" stroke-linecap="round"><path d="${d}"/></svg>`;
};
for (const m of months) {
  const d = new Date(`${m.key}-15T12:00:00Z`);
  m.short = d.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }).slice(0, 3);
  m.year = m.key.slice(0, 4);
}
// Newspaper masthead line under the title
const allIssues = getIssues();
const latestIssue = allIssues[0];

// A doodle beside each month, about one of its stories (inline SVG, decorative)
import fs from 'node:fs';
const MONTH_DOODLES = { '2026-10': 'dog', '2026-09': 'tv', '2026-08': 'sign', '2026-07': 'popcorn', '2026-06': 'gavel', '2026-05': 'ball', '2026-04': 'pledge', '2026-03': 'laptop', '2026-02': 'coin', '2026-01': 'kiosk' };
const doodle = (key) => MONTH_DOODLES[key] && fs.readFileSync(`public/images/figures/dd-${MONTH_DOODLES[key]}.svg`, 'utf8').replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---
<Base title="Digital Accessibility News" description="Digital accessibility news from around the world, collected and commented on by Utku Demiryakan. Grouped by the month each story was first published.">
  <div class="wrap page">
    <div class="sheet head">
    <h1>Digital Accessibility News</h1>
    <span class="fig note-card"><img src="/images/figures/news-reader.svg" alt="" width="311" height="497" /></span>
    <p class="lead">News I found and commented on each week: laws, enforcement, research and products from around the world. Grouped by the month each story was first published.</p>
    <p class="masthead"><span>No. {latestIssue.number}</span><span><time datetime={latestIssue.date}>{formatDateLong(latestIssue.date)}</time></span><span>{items.length} stories, {months.length} months</span></p>

    </div>
    <div class="sheet months">
    <div class="tools"><button type="button" class="toggle-all" hidden>Expand all months</button></div>

    {months.map((m, i) => (
      <section class="month" aria-labelledby={`m-${m.key}`}>
        <h2 id={`m-${m.key}`}>
          <button type="button" class="disclosure" aria-expanded="true" aria-controls={`p-${m.key}`} data-first={i === 0 ? 'true' : undefined}>
            <span class="cal" aria-hidden="true"><Fragment set:html={calendar} /><b>{m.short}</b><small>{m.year}</small></span>
            <span class="label">{m.label}</span>
            <span class="count">{m.items.length} {m.items.length === 1 ? 'story' : 'stories'}</span>
            <span class="tally" set:html={tally(m.items.length)} />
            <span class="chev" aria-hidden="true"></span>
          </button>
        </h2>
        <div class="panel" id={`p-${m.key}`}>
        {doodle(m.key) && <span class="doodle" set:html={doodle(m.key)} />}
        <ul class="grid">
          {m.items.map((it) => (
            <li>
              <article class="card" aria-labelledby={`n-${it.issue}-${it.anchor}`}>
                <p class="meta">
                  {it.published
                    ? <>Published <time datetime={it.published}>{formatDateLong(it.published)}</time></>
                    : <>Shared <time datetime={it.date}>{formatDateLong(it.date)}</time></>}
                  {it.source && <> · {it.source.name}</>}
                </p>
                <h3 id={`n-${it.issue}-${it.anchor}`}>{it.url ? <a href={it.url}>{it.title}</a> : it.title}</h3>
                <p class="ex">{plainText(it.markdown, 170)}</p>
                <a class="go" href={`${it.issueUrl}#${it.anchor}`}>Read on Notes # {it.issue}<span class="visually-hidden">: {it.title}</span> <span aria-hidden="true">→</span></a>
              </article>
            </li>
          ))}
        </ul>
        </div>
      </section>
    ))}
    </div>
  </div>
</Base>

<script is:inline>
  // demo only: ?v=b shows the second variant
  if (new URLSearchParams(location.search).get('v') === 'b') document.documentElement.dataset.newsV = 'b';
</script>
<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.month .disclosure')];
  const toggleAll = document.querySelector<HTMLButtonElement>('.toggle-all');
  const set = (b: HTMLButtonElement, open: boolean) => {
    b.setAttribute('aria-expanded', String(open));
    document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !open;
  };
  const syncAll = () => {
    if (!toggleAll) return;
    const allOpen = buttons.every((b) => b.getAttribute('aria-expanded') === 'true');
    toggleAll.textContent = allOpen ? 'Collapse all months' : 'Expand all months';
  };
  // Only the newest month starts open (without JavaScript every month stays open).
  for (const b of buttons) {
    set(b, b.dataset.first === 'true');
    b.addEventListener('click', () => { set(b, b.getAttribute('aria-expanded') !== 'true'); syncAll(); });
  }
  if (toggleAll) {
    toggleAll.hidden = false;
    toggleAll.addEventListener('click', () => {
      const open = toggleAll.textContent!.startsWith('Expand');
      for (const b of buttons) set(b, open);
      syncAll();
    });
    syncAll();
  }
</script>

<style>
  .page { padding-top: 2.5rem; }
  .lead { font-size: var(--step-1); line-height: 1.45; max-width: 60ch; }
  .tools { display: flex; justify-content: flex-end; margin: 0 0 0.5rem; min-height: 44px; }
  .toggle-all { font: inherit; font-weight: 700; color: var(--notebook); background: none; border: 0; padding: 0; min-height: 44px; text-decoration: underline; text-underline-offset: 0.18em; cursor: pointer; }
  .toggle-all:hover { text-decoration-thickness: 0.16em; }

  .month { border-top: 3px solid var(--notebook); }
  .month:last-of-type { border-bottom: 3px solid var(--notebook); }
  .month h2 { margin: 0; font-size: var(--step-1); }
  .disclosure { font: inherit; color: var(--ink); background: none; border: 0; width: 100%; display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem; padding: 0.9rem 0.25rem; min-height: 56px; cursor: pointer; text-align: left; font-weight: 800; }
  .disclosure:hover .label { text-decoration: underline; text-decoration-thickness: 0.08em; text-underline-offset: 0.18em; }
  .count { font-size: var(--step--1); font-weight: 700; color: var(--ink-soft); }
  .chev { margin-left: auto; width: 2rem; height: 2rem; flex: none; border-radius: 50%; border: 2px solid var(--notebook); position: relative; }
  .chev::before { content: ''; position: absolute; left: 50%; top: 50%; width: 0.5rem; height: 0.5rem; border-right: 2.5px solid var(--notebook); border-bottom: 2.5px solid var(--notebook); transform: translate(-50%, -70%) rotate(45deg); }
  .disclosure[aria-expanded='true'] .chev::before { transform: translate(-50%, -30%) rotate(-135deg); }

  .grid { list-style: none; padding: 0.25rem 0 2rem; margin: 0; display: grid; gap: 1.25rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 40rem) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .panel[hidden] { display: none; }
  .grid li { margin: 0; }
  .card { height: 100%; display: flex; flex-direction: column; background: #fff; border: 2px solid var(--rule); border-radius: 10px; padding: 1.1rem 1.2rem 1.2rem; }
  .card .meta { margin: 0 0 0.5rem; }
  .card h3 { margin: 0 0 0.6rem; font-size: 1.15rem; line-height: 1.3; overflow-wrap: anywhere; }
  .card h3 a { color: var(--ink); }
  .card h3 a:hover { color: var(--notebook); }
  .ex { margin: 0 0 1rem; font-size: 1.02rem; }
  .go { margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; padding: 0.45rem 1rem; border: 2px solid var(--notebook); border-radius: 6px; color: var(--notebook); font-weight: 800; text-decoration: none; }
  .go:hover { background: var(--notebook); color: #fff; }
  @media (forced-colors: active) { .chev::before { border-color: CanvasText; } }

  .head { display: flow-root; }
  .head .fig { float: right; width: 7.5rem; margin: -4.75rem 0.5rem 0 2rem; }
  /* keep the title clear of the figure, which is pulled up beside it */
  @media (min-width: 40.01rem) { .head h1 { margin-right: 10rem; } }
  @media (max-width: 40rem) { .head .fig { width: 5rem; margin: 0.4rem 0 0.5rem 0.9rem; padding: 0.5rem 0.4rem 0.4rem; } }

  /* Month doodles in the left margin, beside the open month */
  @media (min-width: 40.01rem) { .months { --pad-l: 8.5rem; } }
  .panel { position: relative; }
  .doodle { position: absolute; top: 0.25rem; right: calc(100% + 1.6rem); width: 6.2rem; clip-path: inset(-1rem -1rem -1rem calc(7.8rem - var(--pad-l))); pointer-events: none; }
  .doodle :global(svg) { display: block; width: 100%; height: auto; }
  @media (max-width: 40rem) { .doodle { display: none; } }

  /* Calendar sheet beside each month name */
  .cal { position: relative; flex: none; width: 4rem; height: 4.375rem; margin-right: 0.35rem; color: var(--notebook); }
  .cal :global(svg) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cal b { position: absolute; left: 0; right: 0; top: 2.05rem; text-align: center; font-size: 1.15rem; line-height: 1; font-weight: 800; letter-spacing: 0.03em; text-transform: uppercase; }
  .cal small { position: absolute; left: 0; right: 0; top: 1.02rem; text-align: center; font-size: 0.6rem; line-height: 1; font-weight: 800; letter-spacing: 0.06em; }
  .tally { display: inline-flex; align-items: center; }
  .tally :global(svg) { display: block; }

  /* Newspaper masthead line */
  .masthead { clear: both; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1.5rem; margin: 1.5rem 0 0; padding: 0.45rem 0.1rem; border-top: 4px double var(--ink); border-bottom: 1px solid var(--ink); font-size: var(--step--1); font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }

  /* Variant B: no tally or masthead; each month is a dot on the sheet's margin line, filled when open */
  :global(:root[data-news-v='b']) .tally, :global(:root[data-news-v='b']) .masthead { display: none; }
  :global(:root[data-news-v='b']) .month { position: relative; }
  :global(:root[data-news-v='b']) .month::before { content: ''; position: absolute; top: 1.85rem; left: calc(-1 * var(--line-gap) - 6px); width: 14px; height: 14px; border-radius: 50%; border: 2.5px solid var(--notebook); background: #fff; box-sizing: border-box; z-index: 1; }
  :global(:root[data-news-v='b']) .month:has(.disclosure[aria-expanded='true'])::before { background: var(--notebook); }
  :global(:root[data-news-v='b']) .months::before { background-image: linear-gradient(to right, transparent calc(var(--pad-l) - var(--line-gap)), var(--notebook) calc(var(--pad-l) - var(--line-gap)) calc(var(--pad-l) - var(--line-gap) + 2px), transparent 0); }
  @media (forced-colors: active) { .cal b, .cal small { color: CanvasText; } .month::before { border-color: CanvasText !important; } }
</style>
