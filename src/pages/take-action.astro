---
import Base from '../layouts/Base.astro';
import { getPledges, PLEDGE_GROUPS } from '../lib/issues.js';

const MAX = 3;
const pledges = getPledges();
const byRole = PLEDGE_GROUPS.map((g) => ({
  ...g,
  key: g.role.toLowerCase(),
  items: pledges.filter((p) => p.role === g.role).sort((a, b) => a.issue - b.issue),
})).filter((g) => g.items.length);
const SHARE_URL = 'https://accessibilitynotebook.com/take-action/';
---
<Base title="Take Action" image="/images/take-action-og.png"
      description="Turn what you read in Accessibility Notebook into action: pick up to three accessibility actions, download your card and share it.">
  <div class="wrap page">
    <h1>Take Action</h1>
    <p class="lead">Turn what you read here into action. Pick up to three things you will do, then download your card and share it. Every action comes from an Accessibility Notebook issue.</p>
    <p class="arrm">Actions are grouped by the roles in W3C's <a href="https://www.w3.org/WAI/planning/arrm/">Accessibility Roles and Responsibilities Mapping (ARRM)</a>. Open your role, or any other.</p>
    <noscript><p class="note">Making your card needs JavaScript. You can still read every action below.</p></noscript>

    <div class="layout" data-max={MAX}>
      <form class="pick" aria-labelledby="pick-title">
        <h2 id="pick-title" class="visually-hidden">Choose your actions</h2>
        <p class="counter"><span class="count-text">0 of {MAX} chosen</span> <a class="to-card" href="#card-title">See your card <span aria-hidden="true">↓</span></a></p>
        <p class="limit-msg" role="status"></p>
        {byRole.map((g) => (
          <details class="grp" data-role={g.key}>
            <summary>
              <span class="g-name">{g.role}</span>
              <span class="g-meta">{g.covers} · {g.items.length} actions<span class="g-chosen"></span></span>
            </summary>
            <fieldset>
            <legend class="visually-hidden">{g.role} actions</legend>
            {g.items.map((p) => (
              <div class="act">
                <input type="checkbox" id={`p-${p.id}`} value={p.id} data-text={p.text} aria-describedby={`src-${p.id}`} />
                <div>
                  <label for={`p-${p.id}`}>{p.text}</label>
                  <a class="src" id={`src-${p.id}`} href={p.issueUrl}>From Notes # {p.issue}</a>
                </div>
              </div>
            ))}
            </fieldset>
          </details>
        ))}
      </form>

      <aside class="preview" aria-labelledby="card-title">
        <h2 id="card-title" class="ptitle">Your card</h2>
        <fieldset class="formats">
          <legend>Where will you share it?</legend>
          <label><input type="radio" name="format" value="post" checked /> <span>Post <span class="dim">LinkedIn or Instagram · 1080 × 1080 px</span></span></label>
          <label><input type="radio" name="format" value="story" /> <span>Story <span class="dim">Instagram, Facebook or WhatsApp · 1080 × 1920 px</span></span></label>
        </fieldset>
        <div class="frame" data-format="post">
          <img class="card-img" alt="Your card. Pick at least one action to fill it." width="1080" height="1080" />
        </div>
        <div class="btns" hidden>
          <button type="button" class="b1 download">Download image</button>
          <button type="button" class="b2 share" hidden>Share</button>
          <a class="b2 linkedin" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(SHARE_URL)}`} target="_blank" rel="noopener">Post on LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a>
          <button type="button" class="b2 copy">Copy alt text</button>
        </div>
        <p class="tip" hidden></p>
        <p class="alt" hidden><strong>Alt text:</strong> <span class="alt-text"></span></p>
        <p class="visually-hidden" role="status" id="action-status"></p>
      </aside>
    </div>
  </div>
</Base>

<script>
  const layout = document.querySelector<HTMLElement>('.layout')!;
  const MAX = Number(layout.dataset.max);
  const boxes = [...layout.querySelectorAll<HTMLInputElement>('.pick input[type="checkbox"]')];
  const countText = layout.querySelector<HTMLElement>('.count-text')!;
  const limitMsg = layout.querySelector<HTMLElement>('.limit-msg')!;
  const img = layout.querySelector<HTMLImageElement>('.card-img')!;
  const frame = layout.querySelector<HTMLElement>('.frame')!;
  const btns = layout.querySelector<HTMLElement>('.btns')!;
  const tip = layout.querySelector<HTMLElement>('.tip')!;
  const altP = layout.querySelector<HTMLElement>('.alt')!;
  const altSpan = layout.querySelector<HTMLElement>('.alt-text')!;
  const status = layout.querySelector<HTMLElement>('#action-status')!;
  const shareBtn = layout.querySelector<HTMLButtonElement>('.share')!;
  const liLink = layout.querySelector<HTMLElement>('.linkedin')!;
  const radios = [...layout.querySelectorAll<HTMLInputElement>('input[name="format"]')];
  let chosen: HTMLInputElement[] = [];

  // Card formats. Story keeps its content inside the stories' safe area (about 250 px top and bottom).
  type Fmt = { W: number; H: number; top: number; title: number; titleGap: number; item: number; lh: number; gap: number; foot: number; footY: number; fig: number; name: string; file: string; tip: string };
  const FORMATS: Record<string, Fmt> = {
    post: { W: 1080, H: 1080, top: 80, title: 64, titleGap: 120, item: 34, lh: 46, gap: 30, foot: 26, footY: 990, fig: 300, name: 'post', file: 'my-accessibility-actions-post.png',
      tip: 'On LinkedIn, paste the alt text into the image description. On Instagram, open Advanced settings, then Accessibility, and paste it there before you share.' },
    story: { W: 1080, H: 1920, top: 250, title: 104, titleGap: 170, item: 52, lh: 70, gap: 56, foot: 34, footY: 1700, fig: 480, name: 'story', file: 'my-accessibility-actions-story.png',
      tip: 'Stories have no alt text field. Add the alt text as a caption or a text sticker so everyone can read your actions.' },
  };
  let fmt = FORMATS.post;

  const sentence = (t: string) => (/[.!?]$/.test(t) ? t : `${t}.`);
  const altText = () =>
    `My accessibility actions from Accessibility Notebook: ${chosen.map((b, i) => `${i + 1}. ${sentence(b.dataset.text!)}`).join(' ')} Take yours at accessibilitynotebook.com/take-action`;

  // ---- Card image drawn on a canvas; the preview shows the same image ----
  const loadImg = (src: string) => new Promise<HTMLImageElement>((ok, err) => { const i = new Image(); i.onload = () => ok(i); i.onerror = err; i.src = src; });
  const whiteLogo = (im: HTMLImageElement, w: number) => {
    const c = document.createElement('canvas');
    const h = Math.round((im.height / im.width) * w);
    c.width = w; c.height = h;
    const x = c.getContext('2d')!;
    x.drawImage(im, 0, 0, w, h);
    x.globalCompositeOperation = 'source-in';
    x.fillStyle = '#ffffff';
    x.fillRect(0, 0, w, h);
    return c;
  };
  const wrap = (x: CanvasRenderingContext2D, text: string, maxW: number) => {
    const words = text.split(' ');
    const lines: string[] = [];
    let line = '';
    for (const w of words) {
      const t = line ? `${line} ${w}` : w;
      if (x.measureText(t).width > maxW && line) { lines.push(line); line = w; } else line = t;
    }
    if (line) lines.push(line);
    return lines;
  };
  const FONT = '"Atkinson Hyperlegible Next", "Atkinson Hyperlegible", system-ui, sans-serif';
  let logoP: Promise<HTMLImageElement> | null = null;

  // Every text on the card is white.
  const drawCard = async (f: Fmt) => {
    await Promise.all(['400 26px', '700 34px', '800 64px'].map((s) => document.fonts.load(`${s} ${FONT}`).catch(() => null)));
    const logo = await (logoP ||= loadImg('/logo.png'));
    const { W, H } = f;
    const L = 80;
    const c = document.createElement('canvas');
    c.width = W; c.height = H;
    const x = c.getContext('2d')!;
    x.fillStyle = '#2d0a72';
    x.fillRect(0, 0, W, H);
    // faded figure, bottom right
    x.globalAlpha = 0.18;
    x.drawImage(whiteLogo(logo, f.fig), W - f.fig * 0.87, H - f.fig * 0.83);
    x.globalAlpha = 1;
    x.fillStyle = '#ffffff';
    // brand
    const lg = Math.round(f.title * 1.03);
    x.drawImage(whiteLogo(logo, lg), L, f.top);
    x.font = `800 ${Math.round(f.title * 0.53)}px ${FONT}`;
    x.textBaseline = 'middle';
    x.fillText('Accessibility Notebook', L + lg + 20, f.top + lg / 2);
    x.textBaseline = 'alphabetic';
    // title (wraps on the story)
    x.font = `800 ${f.title}px ${FONT}`;
    let y = f.top + lg + f.titleGap;
    for (const line of wrap(x, 'My Accessibility Actions', W - L * 2)) { x.fillText(line, L, y); y += Math.round(f.title * 1.1); }
    y += Math.round(f.item * 1.6);
    // actions: shrink the text a little if three long actions would run into the footer
    let k = 1;
    const fits = (k: number) => {
      x.font = `700 ${Math.round(f.item * k)}px ${FONT}`;
      const tx0 = L + Math.round(f.item * 0.65 * k) * 2 + Math.round(f.item * 0.6 * k);
      const h = chosen.reduce((a, b) => a + wrap(x, sentence(b.dataset.text!), W - tx0 - L).length * f.lh * k + f.gap * k, 0);
      return y + h < f.footY - f.foot * 2;
    };
    while (k > 0.7 && !fits(k)) k -= 0.05;
    f = { ...f, item: Math.round(f.item * k), lh: Math.round(f.lh * k), gap: Math.round(f.gap * k) };
    const r = Math.round(f.item * 0.65);
    if (!chosen.length) {
      x.font = `400 ${f.item}px ${FONT}`;
      x.fillText('Pick up to three actions.', L, y);
    }
    chosen.forEach((b, i) => {
      x.fillStyle = '#ffffff';
      x.beginPath(); x.arc(L + r, y - Math.round(f.item * 0.35), r, 0, Math.PI * 2); x.fill();
      x.fillStyle = '#2d0a72';
      x.font = `800 ${Math.round(f.item * 0.76)}px ${FONT}`;
      x.textAlign = 'center';
      x.fillText(String(i + 1), L + r, y - Math.round(f.item * 0.09));
      x.textAlign = 'left';
      x.font = `700 ${f.item}px ${FONT}`;
      x.fillStyle = '#ffffff';
      const tx = L + r * 2 + Math.round(f.item * 0.6);
      for (const line of wrap(x, sentence(b.dataset.text!), W - tx - L)) { x.fillText(line, tx, y); y += f.lh; }
      y += f.gap;
    });
    // footer
    x.fillStyle = '#ffffff';
    x.font = `400 ${f.foot}px ${FONT}`;
    const lead = 'Take yours at ';
    x.fillText(lead, L, f.footY);
    const leadW = x.measureText(lead).width;
    x.font = `800 ${f.foot}px ${FONT}`;
    x.fillText('accessibilitynotebook.com/take-action', L + leadW, f.footY);
    return new Promise<Blob>((ok) => c.toBlob((bl) => ok(bl!), 'image/png'));
  };

  let previewUrl = '';
  let pending = 0;
  const render = async () => {
    const ticket = ++pending;
    const f = fmt;
    const key = radios.find((r) => r.checked)!.value;
    const url = URL.createObjectURL(await drawCard(f));
    // decode first, then swap image, size and frame together so the preview never jumps
    const next = new Image();
    next.src = url;
    await next.decode().catch(() => null);
    if (ticket !== pending) { URL.revokeObjectURL(url); return; }
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = url;
    img.src = url;
    img.width = f.W; img.height = f.H;
    frame.dataset.format = key;
  };

  const update = () => {
    countText.textContent = `${chosen.length} of ${MAX} chosen`;
    btns.hidden = tip.hidden = altP.hidden = chosen.length === 0;
    altSpan.textContent = chosen.length ? altText() : '';
    img.alt = chosen.length ? `Your ${fmt.name} card. ${altText()}` : `Your ${fmt.name} card. Pick at least one action to fill it.`;
    tip.textContent = fmt.tip;
    liLink.hidden = fmt !== FORMATS.post;
    for (const b of boxes) b.closest('.act')!.classList.toggle('on', b.checked);
    for (const d of layout.querySelectorAll<HTMLElement>('details.grp')) {
      const n = d.querySelectorAll('input:checked').length;
      d.querySelector('.g-chosen')!.textContent = n ? ` · ${n} chosen` : '';
    }
    render();
  };

  for (const b of boxes) {
    b.addEventListener('change', () => {
      if (b.checked) {
        if (chosen.length >= MAX) {
          b.checked = false;
          limitMsg.textContent = `You can choose up to ${MAX}. Unselect one to choose another.`;
          return;
        }
        chosen.push(b);
      } else {
        chosen = chosen.filter((x) => x !== b);
      }
      limitMsg.textContent = '';
      update();
    });
  }
  for (const r of radios) r.addEventListener('change', () => { fmt = FORMATS[r.value]; update(); });

  layout.querySelector('.download')!.addEventListener('click', async () => {
    const blob = await drawCard(fmt);
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = fmt.file;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    status.textContent = `Your ${fmt.name} card was downloaded as ${fmt.file}.`;
  });

  // Native share sheet (mostly phones, where Instagram and LinkedIn appear) when it can share an image file.
  const probe = new File([new Blob()], 'p.png', { type: 'image/png' });
  if (navigator.canShare && navigator.canShare({ files: [probe] })) {
    shareBtn.hidden = false;
    shareBtn.addEventListener('click', async () => {
      const file = new File([await drawCard(fmt)], fmt.file, { type: 'image/png' });
      try {
        await navigator.share({ files: [file], text: `${altText()}` });
      } catch { /* the reader closed the share sheet */ }
    });
  }

  layout.querySelector('.copy')!.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(altText());
      status.textContent = 'Alt text copied.';
    } catch {
      status.textContent = 'Copying did not work. You can select the alt text below and copy it.';
    }
  });

  update();
</script>

<style>
  .page { padding-top: 2.5rem; }
  .lead { font-size: var(--step-1); line-height: 1.45; max-width: 60ch; }
  .note { font-weight: 700; }
  .layout { display: grid; gap: 2rem 3rem; grid-template-columns: minmax(0, 1fr); margin-top: 1.5rem; }
  @media (min-width: 64rem) {
    .layout { grid-template-columns: minmax(0, 1fr) 26rem; }
    .preview { position: sticky; top: 1rem; align-self: start; }
  }
  .counter { font-weight: 800; margin: 0 0 0.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0 1rem; }
  .to-card { display: inline-flex; align-items: center; min-height: 44px; }
  @media (min-width: 64rem) { .to-card { display: none; } }
  #card-title { scroll-margin-top: 1rem; }
  .limit-msg { min-height: 1.6em; margin: 0 0 0.75rem; font-weight: 700; color: #a3123a; }
  .arrm { max-width: 60ch; }
  .grp { border: 2px solid var(--rule); border-radius: 10px; background: #fff; margin: 0 0 0.75rem; }
  .grp[open] { border-color: var(--notebook); }
  .grp summary { display: grid; grid-template-columns: 1fr auto; column-gap: 1rem; align-items: center; padding: 0.85rem 1rem; cursor: pointer; list-style: none; min-height: 48px; }
  .grp summary::-webkit-details-marker { display: none; }
  .grp summary::after { content: ''; grid-column: 2; grid-row: 1 / span 2; width: 0.7rem; height: 0.7rem; border-right: 3px solid var(--notebook); border-bottom: 3px solid var(--notebook); transform: rotate(45deg); margin-top: -0.3rem; transition: transform 0.15s; }
  .grp[open] summary::after { transform: rotate(-135deg); margin-top: 0.3rem; }
  .grp summary:focus-visible { outline: 3px solid var(--notebook); outline-offset: 2px; border-radius: 8px; }
  .g-name { font-weight: 800; font-size: 1.15rem; color: var(--ink); }
  .g-meta { grid-column: 1; font-size: var(--step--1); color: var(--ink-soft); }
  .g-chosen { font-weight: 800; color: var(--notebook); }
  .grp fieldset { border: 0; padding: 0 0.75rem 0.5rem; margin: 0; min-width: 0; }
  @media (prefers-reduced-motion: reduce) { .grp summary::after { transition: none; } }
  .act { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.7rem 0.9rem; border: 2px solid var(--rule); border-radius: 8px; margin-bottom: 0.5rem; background: #fff; }
  .act:hover { border-color: var(--notebook); }
  .act input { width: 1.3rem; height: 1.3rem; margin: 0.2rem 0 0; accent-color: var(--notebook); flex: none; cursor: pointer; }
  .act label { display: block; font-weight: 700; cursor: pointer; }
  .act.on { border-color: var(--notebook); background: var(--tint); }
  .act:has(input:focus-visible) { outline: 3px solid var(--notebook); outline-offset: 2px; }
  .act input:focus-visible { outline: none; }
  .src { display: inline-flex; align-items: center; min-height: 32px; font-size: var(--step--1); }

  .ptitle { font-size: 1.15rem; margin: 0 0 0.6rem; }
  .formats { border: 0; padding: 0; margin: 0 0 1rem; min-width: 0; display: grid; gap: 0.4rem; }
  .formats legend { font-weight: 800; padding: 0; margin-bottom: 0.5rem; }
  .formats label { display: flex; align-items: center; gap: 0.6rem; min-height: 44px; padding: 0.35rem 0.8rem; border: 2px solid var(--rule); border-radius: 8px; background: #fff; font-weight: 700; cursor: pointer; }
  .formats label:has(input:checked) { border-color: var(--notebook); background: var(--tint); }
  .formats label:has(input:focus-visible) { outline: 3px solid var(--notebook); outline-offset: 2px; }
  .formats label > span { display: grid; gap: 0.1rem; line-height: 1.3; padding: 0.25rem 0; }
  .formats input { width: 1.2rem; height: 1.2rem; margin: 0; accent-color: var(--notebook); }
  .formats input:focus-visible { outline: none; }
  .dim { font-weight: 400; color: var(--ink-soft); font-size: var(--step--1); }
  .frame { background: var(--tint); border-radius: 14px; padding: 0.75rem; display: grid; place-items: center; }
  .card-img { display: block; width: min(100%, 26rem); height: auto; aspect-ratio: 1; border-radius: 10px; background: #2d0a72; }
  .frame[data-format='story'] .card-img { width: min(70%, 16rem); aspect-ratio: 9 / 16; }
  .btns { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  .btns[hidden], .tip[hidden], .alt[hidden], .btns .share[hidden], .btns .linkedin[hidden] { display: none; }
  .btns button, .btns a { font: inherit; font-weight: 800; min-height: 48px; padding: 0.6rem 1.2rem; border-radius: 6px; border: 2px solid var(--notebook); cursor: pointer; display: inline-flex; align-items: center; text-decoration: none; }
  .b1 { background: var(--notebook); color: #fff; }
  .b1:hover { background: #fff; color: var(--notebook); }
  .b2 { background: #fff; color: var(--notebook); }
  .b2:hover { background: var(--tint); }
  .tip { font-size: var(--step--1); margin: 1rem 0 0; }
  .alt { font-size: var(--step--1); color: var(--ink-soft); margin-top: 0.75rem; }
</style>
