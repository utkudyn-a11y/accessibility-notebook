---
import Base from '../layouts/Base.astro';
import { getPledges, PLEDGE_ROLES } from '../lib/issues.js';

const MAX = 3;
const pledges = getPledges();
const byRole = PLEDGE_ROLES.map((role) => ({
  role,
  items: pledges.filter((p) => p.role === role).sort((a, b) => a.issue - b.issue),
})).filter((g) => g.items.length);
const SHARE_URL = 'https://accessibilitynotebook.com/pledge/';
---
<Base title="Accessibility Pledge" image="/images/pledge-og.png"
      description="Turn what you read in Accessibility Notebook into action: pick up to three accessibility pledges, download your card and share it.">
  <div class="wrap page">
    <h1>Accessibility Pledge</h1>
    <p class="lead">Turn what you read here into action. Pick up to three things you will do, then download your card and share it. Every pledge comes from an Accessibility Notebook issue.</p>
    <noscript><p class="note">Making your card needs JavaScript. You can still read every pledge below.</p></noscript>

    <div class="layout" data-max={MAX}>
      <form class="pick" aria-labelledby="pick-title">
        <h2 id="pick-title" class="visually-hidden">Choose your pledges</h2>
        <p class="counter"><span class="count-text">0 of {MAX} chosen</span> <a class="to-card" href="#card-title">See your card <span aria-hidden="true">↓</span></a></p>
        <p class="limit-msg" role="status"></p>
        {byRole.map((g, gi) => (
          <fieldset class="grp">
            <legend>{g.role}</legend>
            {g.items.map((p) => (
              <div class="act">
                <input type="checkbox" id={`p-${p.id}`} value={p.id} data-text={p.text} aria-describedby={`src-${p.id}`} />
                <div>
                  <label for={`p-${p.id}`}>{p.text}{p.isNew && <span class="new"> New</span>}</label>
                  <a class="src" id={`src-${p.id}`} href={p.issueUrl}>From Notes # {p.issue}</a>
                </div>
              </div>
            ))}
          </fieldset>
        ))}
      </form>

      <aside class="preview" aria-labelledby="card-title">
        <h2 id="card-title" class="ptitle">Your card</h2>
        <div class="card" role="img" aria-label="Your pledge card. Pick at least one pledge to fill it.">
          <div class="ctop"><img src="/logo.png" alt="" width="160" height="158" /><span>Accessibility Notebook</span></div>
          <p class="ctitle">My accessibility pledge</p>
          <ol class="clist"></ol>
          <p class="cempty">Pick up to three pledges.</p>
          <img class="fig" src="/logo.png" alt="" width="160" height="158" />
          <p class="cfoot">Take yours at <strong>accessibilitynotebook.com/pledge</strong></p>
        </div>
        <div class="btns" hidden>
          <button type="button" class="b1 download">Download image</button>
          <button type="button" class="b2 share" hidden>Share</button>
          <a class="b2 linkedin" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(SHARE_URL)}`} target="_blank" rel="noopener">Post on LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a>
          <button type="button" class="b2 copy">Copy alt text</button>
        </div>
        <p class="tip" hidden>On LinkedIn, attach the downloaded image to your post and paste the alt text into its description.</p>
        <p class="alt" hidden><strong>Alt text:</strong> <span class="alt-text"></span></p>
        <p class="visually-hidden" role="status" id="action-status"></p>
      </aside>
    </div>
  </div>
</Base>

<script>
  const layout = document.querySelector<HTMLElement>('.layout')!;
  const MAX = Number(layout.dataset.max);
  const boxes = [...layout.querySelectorAll<HTMLInputElement>('.pick input[type="checkbox"]')];
  const countText = layout.querySelector<HTMLElement>('.count-text')!;
  const limitMsg = layout.querySelector<HTMLElement>('.limit-msg')!;
  const card = layout.querySelector<HTMLElement>('.card')!;
  const list = card.querySelector<HTMLOListElement>('.clist')!;
  const empty = card.querySelector<HTMLElement>('.cempty')!;
  const btns = layout.querySelector<HTMLElement>('.btns')!;
  const tip = layout.querySelector<HTMLElement>('.tip')!;
  const altP = layout.querySelector<HTMLElement>('.alt')!;
  const altSpan = layout.querySelector<HTMLElement>('.alt-text')!;
  const status = layout.querySelector<HTMLElement>('#action-status')!;
  const shareBtn = layout.querySelector<HTMLButtonElement>('.share')!;
  let chosen: HTMLInputElement[] = [];

  const sentence = (t: string) => (/[.!?]$/.test(t) ? t : `${t}.`);
  const altText = () =>
    `My accessibility pledge from Accessibility Notebook: ${chosen.map((b, i) => `${i + 1}. ${sentence(b.dataset.text!)}`).join(' ')} Take yours at accessibilitynotebook.com/pledge`;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const update = () => {
    countText.textContent = `${chosen.length} of ${MAX} chosen`;
    list.innerHTML = chosen.map((b, i) => `<li><span class="num">${i + 1}</span><span>${esc(sentence(b.dataset.text!))}</span></li>`).join('');
    empty.hidden = chosen.length > 0;
    btns.hidden = tip.hidden = altP.hidden = chosen.length === 0;
    altSpan.textContent = chosen.length ? altText() : '';
    card.setAttribute('aria-label', chosen.length ? `Your pledge card. ${altText()}` : 'Your pledge card. Pick at least one pledge to fill it.');
    for (const b of boxes) b.closest('.act')!.classList.toggle('on', b.checked);
  };

  for (const b of boxes) {
    b.addEventListener('change', () => {
      if (b.checked) {
        if (chosen.length >= MAX) {
          b.checked = false;
          limitMsg.textContent = `You can choose up to ${MAX}. Unselect one to choose another.`;
          return;
        }
        chosen.push(b);
      } else {
        chosen = chosen.filter((x) => x !== b);
      }
      limitMsg.textContent = '';
      update();
    });
  }

  // ---- Card image (1080 × 1080) drawn on a canvas, in the same design as the preview ----
  const loadImg = (src: string) => new Promise<HTMLImageElement>((ok, err) => { const i = new Image(); i.onload = () => ok(i); i.onerror = err; i.src = src; });
  const whiteLogo = (img: HTMLImageElement, w: number) => {
    const c = document.createElement('canvas');
    const h = Math.round((img.height / img.width) * w);
    c.width = w; c.height = h;
    const x = c.getContext('2d')!;
    x.drawImage(img, 0, 0, w, h);
    x.globalCompositeOperation = 'source-in';
    x.fillStyle = '#ffffff';
    x.fillRect(0, 0, w, h);
    return c;
  };
  const wrap = (x: CanvasRenderingContext2D, text: string, maxW: number) => {
    const words = text.split(' ');
    const lines: string[] = [];
    let line = '';
    for (const w of words) {
      const t = line ? `${line} ${w}` : w;
      if (x.measureText(t).width > maxW && line) { lines.push(line); line = w; } else line = t;
    }
    if (line) lines.push(line);
    return lines;
  };
  const FONT = '"Atkinson Hyperlegible Next", "Atkinson Hyperlegible", system-ui, sans-serif';

  const drawCard = async () => {
    await Promise.all(['400 26px', '700 34px', '800 64px'].map((f) => document.fonts.load(`${f} ${FONT}`).catch(() => null)));
    const logo = await loadImg('/logo.png');
    const S = 1080;
    const c = document.createElement('canvas');
    c.width = S; c.height = S;
    const x = c.getContext('2d')!;
    x.fillStyle = '#2d0a72';
    x.fillRect(0, 0, S, S);
    // faded figure, bottom right
    x.globalAlpha = 0.18;
    x.drawImage(whiteLogo(logo, 300), S - 260, S - 250);
    x.globalAlpha = 1;
    // brand
    x.drawImage(whiteLogo(logo, 66), 80, 80);
    x.fillStyle = '#ffffff';
    x.font = `800 34px ${FONT}`;
    x.textBaseline = 'middle';
    x.fillText('Accessibility Notebook', 166, 113);
    // title
    x.fillStyle = '#ffd84d';
    x.font = `800 64px ${FONT}`;
    x.textBaseline = 'alphabetic';
    x.fillText('My accessibility pledge', 80, 275);
    // pledges
    let y = 360;
    x.font = `700 34px ${FONT}`;
    chosen.forEach((b, i) => {
      x.fillStyle = '#ffd84d';
      x.beginPath(); x.arc(102, y - 12, 22, 0, Math.PI * 2); x.fill();
      x.fillStyle = '#1c1530';
      x.font = `800 26px ${FONT}`;
      x.textAlign = 'center';
      x.fillText(String(i + 1), 102, y - 3);
      x.textAlign = 'left';
      x.font = `700 34px ${FONT}`;
      x.fillStyle = '#ffffff';
      for (const line of wrap(x, sentence(b.dataset.text!), S - 147 - 80)) { x.fillText(line, 147, y); y += 46; }
      y += 30;
    });
    // footer
    x.font = `400 26px ${FONT}`;
    x.fillStyle = '#e4dcfa';
    const lead = 'Take yours at ';
    x.fillText(lead, 80, 990);
    const leadW = x.measureText(lead).width;
    x.font = `800 26px ${FONT}`;
    x.fillStyle = '#ffffff';
    x.fillText('accessibilitynotebook.com/pledge', 80 + leadW, 990);
    return new Promise<Blob>((ok) => c.toBlob((bl) => ok(bl!), 'image/png'));
  };

  layout.querySelector('.download')!.addEventListener('click', async () => {
    const blob = await drawCard();
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'my-accessibility-pledge.png';
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    status.textContent = 'Your card was downloaded as my-accessibility-pledge.png.';
  });

  // Native share sheet (mostly phones) when it can share an image file.
  const probe = new File([new Blob()], 'p.png', { type: 'image/png' });
  if (navigator.canShare && navigator.canShare({ files: [probe] })) {
    shareBtn.hidden = false;
    shareBtn.addEventListener('click', async () => {
      const file = new File([await drawCard()], 'my-accessibility-pledge.png', { type: 'image/png' });
      try {
        await navigator.share({ files: [file], text: `${altText()}` });
      } catch { /* the reader closed the share sheet */ }
    });
  }

  layout.querySelector('.copy')!.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(altText());
      status.textContent = 'Alt text copied.';
    } catch {
      status.textContent = 'Copying did not work. You can select the alt text below and copy it.';
    }
  });

  update();
</script>

<style>
  .page { padding-top: 2.5rem; }
  .lead { font-size: var(--step-1); line-height: 1.45; max-width: 60ch; }
  .note { font-weight: 700; }
  .layout { display: grid; gap: 2rem 3rem; grid-template-columns: minmax(0, 1fr); margin-top: 1.5rem; }
  @media (min-width: 64rem) {
    .layout { grid-template-columns: minmax(0, 1fr) 26rem; }
    .preview { position: sticky; top: 1rem; align-self: start; }
  }
  .counter { font-weight: 800; margin: 0 0 0.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0 1rem; }
  .to-card { display: inline-flex; align-items: center; min-height: 44px; }
  @media (min-width: 64rem) { .to-card { display: none; } }
  #card-title { scroll-margin-top: 1rem; }
  .limit-msg { min-height: 1.6em; margin: 0 0 0.75rem; font-weight: 700; color: #a3123a; }
  .grp { border: 0; padding: 0; margin: 0 0 1.5rem; min-width: 0; }
  .grp legend { font-weight: 800; font-size: 1.15rem; padding: 0; margin-bottom: 0.5rem; }
  .act { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.7rem 0.9rem; border: 2px solid var(--rule); border-radius: 8px; margin-bottom: 0.5rem; background: #fff; }
  .act:hover { border-color: var(--notebook); }
  .act input { width: 1.3rem; height: 1.3rem; margin: 0.2rem 0 0; accent-color: var(--notebook); flex: none; cursor: pointer; }
  .act label { display: block; font-weight: 700; cursor: pointer; }
  .act.on { border-color: var(--notebook); background: var(--tint); }
  .act:has(input:focus-visible) { outline: 3px solid var(--notebook); outline-offset: 2px; }
  .act input:focus-visible { outline: none; }
  .new { display: inline-block; margin-left: 0.4rem; font-size: 0.8rem; font-weight: 800; background: var(--highlight); color: var(--ink); border-radius: 4px; padding: 0.05rem 0.4rem; }
  .src { display: inline-flex; align-items: center; min-height: 32px; font-size: var(--step--1); }

  .ptitle { font-size: 1.15rem; margin: 0 0 0.6rem; }
  .card { position: relative; overflow: hidden; width: 100%; aspect-ratio: 1; padding: 1.6rem; background: #2d0a72; color: #fff; border-radius: 14px; display: flex; flex-direction: column; font-size: 1.05rem; }
  .ctop { display: flex; align-items: center; gap: 0.6em; font-weight: 800; font-size: 0.8em; }
  .ctop img { width: 2.2em; height: auto; filter: brightness(0) invert(1); }
  .ctitle { font-weight: 800; font-size: 1.65em; line-height: 1.1; margin: 1.1em 0 0.8em; color: #ffd84d; }
  .clist { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75em; font-weight: 700; font-size: 0.92em; line-height: 1.3; }
  .clist :global(li) { display: flex; gap: 0.6em; margin: 0; }
  .clist :global(.num) { flex: none; width: 1.5em; height: 1.5em; border-radius: 50%; background: #ffd84d; color: #1c1530; display: grid; place-items: center; font-weight: 800; font-size: 0.85em; margin-top: 0.05em; }
  .cempty { color: #e4dcfa; margin: 0; }
  .fig { position: absolute; right: -0.6em; bottom: -0.6em; width: 7.5em; height: auto; filter: brightness(0) invert(1); opacity: 0.18; }
  .cfoot { position: relative; margin: auto 0 0; font-size: 0.7em; color: #e4dcfa; }
  .cfoot strong { color: #fff; }

  .btns { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  .btns[hidden], .tip[hidden], .alt[hidden], .share[hidden] { display: none; }
  .btns button, .btns a { font: inherit; font-weight: 800; min-height: 48px; padding: 0.6rem 1.2rem; border-radius: 6px; border: 2px solid var(--notebook); cursor: pointer; display: inline-flex; align-items: center; text-decoration: none; }
  .b1 { background: var(--notebook); color: #fff; }
  .b1:hover { background: #fff; color: var(--notebook); }
  .b2 { background: #fff; color: var(--notebook); }
  .b2:hover { background: var(--tint); }
  .tip { font-size: var(--step--1); margin: 1rem 0 0; }
  .alt { font-size: var(--step--1); color: var(--ink-soft); margin-top: 0.75rem; }
</style>
