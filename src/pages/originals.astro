---
import Base from '../layouts/Base.astro';
import { getInDetail, getPersonalNotes, formatDate, plainText } from '../lib/issues.js';
const articles = getInDetail();
const notes = getPersonalNotes();

// Doodles in the margin next to a few entries, as if drawn on the edge of the notebook page.
// Keyed by the entry's link; keep them few and never on the same row in both columns.
import fs from 'node:fs';
const DOODLES = {
  '/in-detail/what-did-we-focus-on-for-alt-texts-at-turkish-airlines/': 'plane',
  '/in-detail/norway-font-for-the-2026-fifa-world-cup/': 'ball',
  '/in-detail/why-i-choose-six-hands-marker-typeface-in-accessibility-notebook/': 'marker',
  '/in-detail/museums-and-digital-accessibility/': 'museum',
  '/in-detail/what-w3c-says-on-captchas/': 'captcha',
  '/in-detail/ai-and-human-collaboration-in-accessibility-work-the-binclusive-example/': 'handshake',
  '/in-detail/common-accessibility-failures-in-the-seat-maps/': 'seat',
  '/in-detail/the-short-history-of-10-16-may-disability-awareness-week/': 'megaphone',
  '/notes/30/#personal-notes': 'book',
  '/notes/29/#personal-notes': 'scarf',
  '/notes/27/#personal-notes': 'music',
  '/notes/26/#personal-notes': 'card',
  '/notes/14/#personal-notes': 'ticket',
  '/notes/8/#personal-notes': 'disco',
  '/notes/6/#personal-notes': 'walk',
};
const doodle = (url) => {
  const name = DOODLES[url];
  if (!name) return null;
  // inline, so its lines can be drawn in; pathLength lets one dash length fit every line
  return fs.readFileSync(`public/images/figures/dd-${name}.svg`, 'utf8').replace(/<path /g, '<path pathLength="1" ').replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
};
---
<Base title="Originals" description="Everything Utku Demiryakan wrote himself for Accessibility Notebook: in-depth articles and personal notes on digital accessibility.">
  <div class="wrap page">
    <div class="sheet head">
    <h1>Originals</h1>
    <span class="fig note-card"><img src="/images/figures/writer.svg" alt="" width="481" height="630" /></span>
    <p class="lead reading">Everything I wrote myself: in-depth articles on standards, research and practice, and personal notes from my life as a partially sighted accessibility specialist.</p>

    <p class="jump"><a href="#personal-notes">See Personal Notes <span class="arrow" aria-hidden="true">↓</span></a></p>

    </div>
    <div class="cols">
      <section class="sheet" aria-labelledby="in-detail-title">
        <div class="sec-head">
          <img src="/images/figures/indetail.svg" alt="" width="257" height="357" />
          <h2 id="in-detail-title" class="chalk">In Detail</h2>
        </div>
        <ul class="entries">
          {articles.map((a) => (
            <li>
              {doodle(a.url) && <span class="doodle" set:html={doodle(a.url)} />}
              <h3><a href={a.url}>{a.title}</a></h3>
              <p class="meta"><time datetime={a.issue.date}>{formatDate(a.issue.date)}</time>, Notes # {a.issue.number}</p>
              <p>{plainText(a.markdown, 180)}</p>
            </li>
          ))}
        </ul>
      </section>
      <section class="sheet" id="personal-notes" aria-labelledby="notes-title">
        <div class="sec-head">
          <img src="/images/figures/pnotes.svg" alt="" width="250" height="296" />
          <h2 id="notes-title" class="chalk">Personal Notes</h2>
        </div>
        <ul class="entries">
          {notes.map((n) => (
            <li>
              {doodle(n.url) && <span class="doodle" set:html={doodle(n.url)} />}
              <h3><a href={n.url}>{n.title}</a></h3>
              <p class="meta"><time datetime={n.issue.date}>{formatDate(n.issue.date)}</time>, Notes # {n.issue.number}</p>
              <p>{plainText(n.markdown, 180)}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Base>

<script>
  // Margin doodles: never two on the same row when the columns sit side by side; drawn in as they scroll into view
  const all = [...document.querySelectorAll<HTMLElement>('.doodle')];
  const separate = () => {
    all.forEach((d) => (d.hidden = false));
    const cols = [...document.querySelectorAll('.cols > .sheet')];
    if (cols.length < 2 || (cols[0] as HTMLElement).offsetTop !== (cols[1] as HTMLElement).offsetTop) return;
    const left = [...cols[0].querySelectorAll<HTMLElement>('.doodle')].map((d) => d.getBoundingClientRect());
    for (const d of cols[1].querySelectorAll<HTMLElement>('.doodle')) {
      const r = d.getBoundingClientRect();
      if (left.some((l) => l.top < r.bottom + 60 && r.top < l.bottom + 60)) d.hidden = true;
    }
  };
  separate();
  addEventListener('resize', separate);
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('doodle-anim');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('drawn'); io.unobserve(e.target); } }), { threshold: 0.5 });
    all.forEach((d) => io.observe(d));
  }
</script>
<style>
  .page { padding-top: 2.5rem; }
  .lead { font-size: var(--step-1); line-height: 1.45; }
  .head { display: flow-root; }
  .head .fig { float: right; width: 9rem; margin: -4.75rem 0.5rem 0 2rem; } /* pulled up beside the title on wide screens */
  @media (max-width: 40rem) { .head .fig { width: 6rem; margin: 0.4rem 0 0.5rem 0.9rem; padding: 0.5rem 0.4rem 0.4rem; } }
  /* In Detail and Personal Notes: two sheets, side by side on wide screens */
  .cols { display: grid; gap: 0 2.25rem; align-items: start; }
  @media (min-width: 64rem) { .cols { grid-template-columns: 1fr 1fr; } }
  .entries li { position: relative; }
  /* a wider margin on these two sheets, so the doodles fit on the paper */
  @media (min-width: 40.01rem) { .cols > .sheet { --pad-l: 8.5rem; } }
  /* drawn on the page edge: it may not fit, the paper edge cuts it */
  .doodle { position: absolute; top: 0.4rem; right: calc(100% + 1.6rem); width: 6.2rem; clip-path: inset(-1rem -1rem -1rem calc(7.8rem - var(--pad-l))); pointer-events: none; }
  .doodle :global(svg) { display: block; width: 100%; height: auto; }
  .doodle[hidden] { display: none; }
  :global(.doodle-anim) .doodle :global(path) { stroke-dasharray: 1; stroke-dashoffset: 1; }
  :global(.doodle-anim) .doodle :global(circle) { opacity: 0; }
  :global(.doodle-anim) .doodle.drawn :global(path) { stroke-dashoffset: 0; transition: stroke-dashoffset 1.6s ease-out; }
  :global(.doodle-anim) .doodle.drawn :global(circle) { opacity: 1; transition: opacity 0.4s 1s; }
  @media (max-width: 40rem) {
    .doodle { position: static; float: right; width: 4.5rem; margin: 0 0 0.5rem 0.75rem; clip-path: none; }
  }
  .sec-head { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; }
  .sec-head img { width: 4.5rem; height: auto; flex: none; }
  .sec-head h2 { margin: 0; font-size: var(--step-1); }
  /* Shortcut to Personal Notes, only when the two lists sit one under the other */
  .jump { margin: 1rem 0 0; }
  .jump a { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; font-weight: 800; }
  .jump .arrow { font-size: 1.3em; line-height: 1; }
  @media (min-width: 64rem) { .jump { display: none; } }
  #personal-notes { scroll-margin-top: 1rem; }
  @media (prefers-reduced-motion: no-preference) { :global(html) { scroll-behavior: smooth; } }
  .entries { list-style: none; padding: 0; margin: 0; }
  .entries li { padding: 1.25rem 0; border-bottom: 2px solid var(--rule); }
  .entries li + li { margin-top: 0; }
  .entries h3 { margin: 0 0 0.3rem; font-size: 1.2rem; line-height: 1.3; }
  .entries h3 a { color: var(--ink); }
  .entries h3 a:hover { color: var(--notebook); }
  .entries .meta { margin-bottom: 0.4rem; }
  .entries p:last-child { margin: 0; }
</style>
