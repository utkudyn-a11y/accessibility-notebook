---
import Base from '../layouts/Base.astro';
import IssueCard from '../components/IssueCard.astro';
import Subscribe from '../components/Subscribe.astro';
import SpinAlbum from '../components/SpinAlbum.astro';
import DiscussionCorner from '../components/DiscussionCorner.astro';
import OneMinute from '../components/OneMinute.astro';
import { getIssues, render } from '../lib/issues.js';
import aiPolicy from '../content/site/ai-policy.md?raw';

const issues = getIssues();
const [latest, ...rest] = issues;
const previous = rest.slice(0, 3);
---
<Base>
  <div class="wrap home">
    <h1 class="visually-hidden">Accessibility Notebook</h1>
    <div class="sheet">
    <OneMinute issue={latest} first />

    <section aria-labelledby="latest-title">
      <h2 id="latest-title" class="section-title chalk">Latest Issue</h2>
      <IssueCard issue={latest} size="large" headingLevel={3} />
    </section>

    <section aria-labelledby="previous-title">
      <h2 id="previous-title" class="section-title chalk">Previous Issues</h2>
      <ul class="previous">
        {previous.map((i) => <li><IssueCard issue={i} headingLevel={3} /></li>)}
      </ul>
      <p><a href="/notes/">All issues</a></p>
    </section>
    </div>

    <div class="sheet"><SpinAlbum /></div>

    <div class="sheet"><DiscussionCorner /></div>

    <div class="sheet sheet--bare"><Subscribe /></div>

    <div class="sheet">
    <section aria-labelledby="ai-title" class="ai-policy reading">
      <span class="fig note-card"><img src="/images/figures/handshake.svg" alt="" width="463" height="555" /></span>
      <h2 id="ai-title" class="chalk">AI Policy</h2>
      <div class="prose" set:html={render(aiPolicy)} />
    </section>
    </div>
  </div>
</Base>


<style>
  .home { padding-top: 2.5rem; padding-bottom: 1rem; }
  .section-title { font-size: var(--step-1); margin: 3rem 0 1rem; }
  section:first-of-type .section-title { margin-top: 0; }
  .previous { list-style: none; padding: 0; margin: 0 0 1rem; display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .previous li + li { margin-top: 0; }
  .ai-policy { margin-top: 3rem; }
  .ai-policy { display: flow-root; }
  .ai-policy h2 { font-size: var(--step-1); display: flow-root; }
  .ai-policy .fig { float: right; width: 10rem; margin: 0.5rem 0.5rem 1rem 2rem; }
  @media (max-width: 40rem) { .ai-policy .fig { width: 6.5rem; margin: 0.25rem 0.25rem 0.75rem 1rem; padding: 0.6rem 0.5rem 0.5rem; } }
</style>
