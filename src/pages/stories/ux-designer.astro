---
// Interactive story: UX Designer's Choice. Five decisions, each changing three stats (money, inclusion,
// career); shortcuts also add hidden accessibility debt that is revealed "six weeks later", followed by
// up to three events. Score = Money + Inclusion × Career. Every result links to the issue behind it.
// Progress lives in this tab only (sessionStorage), so a reader can open a "Why?" link and come back.
// Accessibility: real buttons, stats as text, every change written out in words, focus moves to each new
// heading (so screen readers read it), no timers and no animation.
import Base from '../../layouts/Base.astro';
---
<Base title="UX Designer's Choice: The New Year Rush" description="An interactive story. You are the only UX designer at an online shop, six weeks before New Year. Make five decisions and see what they cost you, today and later.">
  <div class="wrap page reading">
    <p class="game-back"><a href="/stories/">← All stories</a></p>
    <div class="sheet game">
      <h1 tabindex="-1">UX Designer's Choice: The New Year Rush</h1>

      <noscript><p>This story needs JavaScript to play.</p></noscript>

      <div class="screen" data-screen="intro">
        <img class="fig" src="/images/figures/role-design.svg" alt="" width="571" height="485" />
        <p>New Year is six weeks away, and your online shop is getting a New Year design. You are its only UX designer.</p>
        <p>You start with a <strong>$20k design budget</strong>, <strong>5 inclusion points</strong> and <strong>5 career points</strong>.</p>
        <p>Make five decisions. Some bills come later.</p>
        <div class="intro-btns">
          <button type="button" class="btn" data-continue hidden>Continue where you left off</button>
          <button type="button" class="btn" data-start>Start the story</button>
        </div>
      </div>

      <div class="play" hidden>
        <h2 class="visually-hidden">Your stats</h2>
        <dl class="stats">
          <div><dt>Money</dt><dd data-stat="money">$20k</dd></div>
          <div><dt>Inclusion</dt><dd data-stat="inclusion">5</dd></div>
          <div><dt>Career</dt><dd data-stat="career">5</dd></div>
        </dl>
        <div class="screen" data-screen="game"></div>
      </div>
      <p class="visually-hidden" role="status" data-status></p>
    </div>
  </div>
</Base>

<script>
  type Fx = { money?: number; inclusion?: number; career?: number };
  type Stats = { money: number; inclusion: number; career: number };
  type Why = { issue: number; anchor: string; label: string; access: string; shortcut: string };
  type Choice = { label: string; access: boolean; fx: Fx; result: string };
  type Step = { fig: string; title: string; scene: (p: number[]) => string; choices: [Choice, Choice]; why: Why };

  const A = (label: string, fx: Fx, result: string): Choice => ({ label, access: true, fx, result });
  const S = (label: string, result: string): Choice => ({ label, access: false, fx: { inclusion: -1, career: 2 }, result });
  const acc = (p: number[], i: number) => p[i] !== undefined && STEPS[i].choices[p[i]].access;

  const STEPS: Step[] = [
    {
      fig: 'st-homepage', title: 'The New Year homepage',
      scene: () => 'The CEO wants the New Year homepage by Monday. An AI tool can generate one in minutes: a carousel, two pop-ups and three banners.',
      choices: [
        S('Generate it and ship it', 'The CEO loves your speed. The page is loud and crowded, but it’s live.'),
        A('Simplify it and run the 75-year-old test', { money: -2, inclusion: 2, career: -1 }, 'You miss Monday by a day. The CEO sighs, but the page is calm and easy to follow.'),
      ],
      why: { issue: 8, anchor: 'inspiration-1', label: 'Notes # 8',
        shortcut: 'The average homepage now has 1,437 elements, 22.5% more than the year before. AI tools learn from those crowded pages, so they make more of them.',
        access: 'Every UX designer should take the 75-year-old test: can a 75-year-old with low vision use this site successfully?' },
    },
    {
      fig: 'st-focus', title: 'The focus outline',
      scene: () => 'The developer building your design system says the focus outline looks ugly on the new buttons. “Can I just remove it?”',
      choices: [
        A('Keep it, and design a better-looking one together', { money: -2, inclusion: 2 }, 'You spend an afternoon with the developer. The new outline looks good, and the developer now asks you about accessibility first.'),
        S('Sure, remove it', 'The buttons look cleaner, and the developer ships faster. Keyboard users can no longer see where they are.'),
      ],
      why: { issue: 5, anchor: 'inspiration-1', label: 'Notes # 5',
        shortcut: 'Keyboard users need the focus indicator to see where they are on the page. Without it, they are lost.',
        access: 'A focus indicator can be visible and good-looking at the same time. Pope Tech’s guide shows how, and its “Common Pitfalls” section is the most useful part.' },
    },
    {
      fig: 'st-banner', title: 'The New Year sale banner',
      scene: (p) => acc(p, 0)
        ? 'The marketing lead wants “New Year sale: 50% off” written on top of the hero photo.'
        : '“The homepage is so busy that nobody will notice the sale,” the marketing lead says. She wants “New Year sale: 50% off” written big, right on top of the hero photo.',
      choices: [
        S('Put the text on the photo', 'The marketing lead is happy. For partially sighted shoppers, the sale disappears into the photo.'),
        A('Put the text on a plain background next to the photo', { money: -2, inclusion: 2, career: -1 }, 'The marketing lead calls it “a bit boring”. But everyone can read the sale, and nobody misses it.'),
      ],
      why: { issue: 29, anchor: 'inspiration-2', label: 'Notes # 29',
        shortcut: 'As a partially sighted person, text on images is one of my biggest challenges.',
        access: 'When people ask me about text on images, my simplest advice is: use text on a plain background.' },
    },
    {
      fig: 'st-checkout', title: 'The checkout',
      scene: (p) => 'The first week of the sale went well, and the product manager wants more. He asks for a pre-ticked “Add insurance” box at checkout and a cancellation process that takes five screens.'
        + (acc(p, 1) ? ' The developer is in the meeting too.' : ''),
      choices: [
        A('Push back and propose an honest checkout', { money: -2, inclusion: 2 }, ''),
        S('Design it', 'Sales go up, and the product manager praises you at the all-hands meeting. Some customers buy insurance they never wanted.'),
      ],
      why: { issue: 32, anchor: 'inspiration-2', label: 'Notes # 32',
        shortcut: 'No WCAG success criterion prevents dark patterns like misleading checkboxes or painful cancellation processes. Yet they can block people with cognitive disabilities or attention issues, or make them take actions they never wanted.',
        access: 'WCAG compliance does not mean inclusion. Dark patterns can pass WCAG and still take away some people’s independence.' },
    },
    {
      fig: 'st-darkmode', title: 'Dark mode',
      scene: () => 'Users keep asking for dark mode, and the CEO wants it live before New Year. You could invert all the colours and launch it today.',
      choices: [
        S('Invert the colours and launch', 'Dark mode is live today. Some icons vanish and some text is hard to read.'),
        A('Go through a dark mode checklist first', { money: -2, inclusion: 2 }, 'It takes a week, but dark mode works for everyone who turns it on.'),
      ],
      why: { issue: 31, anchor: 'inspiration-3', label: 'Notes # 31',
        shortcut: 'Inverted colours are not a dark mode. Russ Weakley’s practical checklist shows what to check before you launch one.',
        access: 'Russ Weakley’s dark mode checklist works for designers and developers alike: just answer “Yes” or “No” to each question.' },
    },
  ];

  // Decision 4's accessible choice depends on whether the developer is on your side (Decision 2)
  const resultOf = (p: number[], i: number): { text: string; fx: Fx } => {
    const c = STEPS[i].choices[p[i]];
    if (i === 3 && c.access) {
      return acc(p, 1)
        ? { text: 'The developer backs you up: “Honest flows are easier to build, too.” The product manager agrees, and your team sees you lead.', fx: { ...c.fx, career: 1 } }
        : { text: 'The product manager isn’t happy, but the checkout stays honest.', fx: { ...c.fx, career: -1 } };
    }
    return { text: c.result, fx: c.fx };
  };

  type Later = { title: string; text: string; fx: Fx; like?: { issue: number; anchor: string; label: string; text: string } };
  const laterScreens = (p: number[]): Later[] => {
    const debt = p.filter((x, i) => !STEPS[i].choices[x].access).length;
    const accCount = STEPS.length - debt;
    const out: Later[] = [debt
      ? { title: 'The bill', fx: { money: -3 * debt },
          text: `Every shortcut left an issue behind. You have ${debt} ${debt === 1 ? 'issue' : 'issues'} to fix now, and fixing them later costs more than doing it right: $3k each.` }
      : { title: 'The bill', fx: {}, text: 'You left no accessibility debt behind. Nothing to fix.' }];
    if (debt >= 3) out.push({ title: 'A letter', fx: { money: -6, career: -3 },
      text: 'A letter arrives from a law firm. A disabled customer tried to buy her New Year gifts on your shop and couldn’t, because of the accessibility issues you left behind. The company settles, and your manager asks why nobody checked.',
      like: { issue: 29, anchor: 'news-3', label: 'Notes # 29', text: 'Candycopia, a small candy shop, faced a five-figure settlement over its website’s ADA compliance. It had relied on third-party apps and a developer, and hadn’t invested much in its online presence.' } });
    if (acc(p, 0) && acc(p, 2)) out.push({ title: 'An email', fx: { career: 2 },
      text: 'A customer writes: “I’m partially sighted, and your New Year page is the first one I could shop without getting lost. Thank you for keeping it simple.” The CEO shares her email with the whole company.' });
    if (accCount >= 4) out.push({ title: 'An invitation', fx: { career: 3 },
      text: 'A design conference invites you to talk about your accessible redesign. Your talk is the most shared of the day.' });
    return out;
  };


  type Ending = { title: string; text: string; fig: string; acc: number; score: number };
  const ending = (s: State): Ending => {
    const n = s.picks.filter((x, i) => STEPS[i].choices[x].access).length;
    const score = s.stats.money + s.stats.inclusion * s.stats.career;
    if (n === 5) return { title: 'Accessibility champion', fig: 'st-champion', acc: n, score, text: 'Your career started slowly, but it grew on trust. Disabled customers can shop on their own, and they come back.' };
    if (n >= 3) return { title: 'A thoughtful designer', fig: 'st-thoughtful', acc: n, score, text: 'You cut a few corners, but you cared when it mattered. Next time, maybe one more push back?' };
    return { title: 'Fast climber, hard landing', fig: 'st-landing', acc: n, score, text: 'You climbed fast, but the shortcuts caught up with you. Accessibility debt always sends the bill later.' };
  };
  const FIG_ALT: Record<string, string> = {
    'st-champion': 'a cheering stickperson next to a trophy',
    'st-thoughtful': 'a stickperson thinking, with a tick and a cross in a thought bubble',
    'st-landing': 'a dazed stickperson sitting at the bottom of the stairs',
  };
  const altText = (e: Ending) => `My result in UX Designer's Choice: The New Year Rush, an interactive story on Accessibility Notebook. ${e.title}, ${FIG_ALT[e.fig]}. Score: ${num(e.score)}. I chose accessibility in ${e.acc} of 5 decisions. Play at accessibilitynotebook.com/stories`;

  // ---- Share card, drawn on a canvas (same look as the Take Action cards) ----
  const FONT = '"Atkinson Hyperlegible Next", "Atkinson Hyperlegible", system-ui, sans-serif';
  const loadImg = (src: string) => new Promise<HTMLImageElement>((ok, err) => { const i = new Image(); i.onload = () => ok(i); i.onerror = err; i.src = src; });
  const whiteLogo = (im: HTMLImageElement, w: number) => {
    const c = document.createElement('canvas'); const h = Math.round((im.height / im.width) * w);
    c.width = w; c.height = h; const x = c.getContext('2d')!;
    x.drawImage(im, 0, 0, w, h); x.globalCompositeOperation = 'source-in'; x.fillStyle = '#ffffff'; x.fillRect(0, 0, w, h);
    return c;
  };
  // the figure's lines turn white and its filled shapes take the card's purple
  const whiteFigure = async (name: string) => {
    const svg = (await (await fetch(`/images/figures/${name}.svg`)).text())
      .replaceAll('#2d0a72', '#ffffff').replaceAll('#fcfbff', '#2d0a72');
    const url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));
    try { return await loadImg(url); } finally { setTimeout(() => URL.revokeObjectURL(url), 1000); }
  };
  const wrap = (x: CanvasRenderingContext2D, text: string, maxW: number) => {
    const lines: string[] = []; let line = '';
    for (const w of text.split(' ')) { const t = line ? `${line} ${w}` : w; if (x.measureText(t).width > maxW && line) { lines.push(line); line = w; } else line = t; }
    if (line) lines.push(line);
    return lines;
  };
  const drawCard = async (e: Ending) => {
    await Promise.all(['400 30px', '700 36px', '800 72px'].map((f) => document.fonts.load(`${f} ${FONT}`).catch(() => null)));
    const [logo, fig] = await Promise.all([loadImg('/logo.png'), whiteFigure(e.fig)]);
    const W = 1080, H = 1080, L = 80;
    const c = document.createElement('canvas'); c.width = W; c.height = H;
    const x = c.getContext('2d')!;
    x.fillStyle = '#2d0a72'; x.fillRect(0, 0, W, H);
    x.fillStyle = '#ffffff';
    const lg = 66;
    x.drawImage(whiteLogo(logo, lg), L, 80);
    x.font = `800 34px ${FONT}`; x.textBaseline = 'middle'; x.fillText('Accessibility Notebook', L + lg + 20, 80 + lg / 2); x.textBaseline = 'alphabetic';
    x.font = `700 32px ${FONT}`;
    let y = 250;
    for (const line of wrap(x, "UX Designer's Choice: The New Year Rush", W - L * 2)) { x.fillText(line, L, y); y += 42; }
    y += 50;
    x.font = `800 68px ${FONT}`;
    for (const line of wrap(x, e.title, 560)) { x.fillText(line, L, y); y += 76; }
    y += 30;
    x.font = `400 32px ${FONT}`; x.fillText('Score', L, y); y += 110;
    x.font = `800 120px ${FONT}`; x.fillText(num(e.score), L, y); y += 70;
    x.font = `700 34px ${FONT}`;
    for (const line of wrap(x, `I chose accessibility in ${e.acc} of 5 decisions.`, 520)) { x.fillText(line, L, y); y += 46; }
    // figure on the right
    const fw = 360, fh = Math.round((fig.height / fig.width) * fw);
    x.drawImage(fig, W - L - fw, 930 - fh, fw, fh);
    x.font = `400 28px ${FONT}`;
    const lead = 'Play at ';
    x.fillText(lead, L, 1000);
    const lw = x.measureText(lead).width;
    x.font = `800 28px ${FONT}`; x.fillText('accessibilitynotebook.com/stories', L + lw, 1000);
    return new Promise<Blob>((ok) => c.toBlob((b) => ok(b!), 'image/png'));
  };
  let cardBlob: Blob | null = null, cardUrl = '';
  const showCard = async (s: State) => {
    const e = ending(s);
    cardBlob = await drawCard(e);
    if (cardUrl) URL.revokeObjectURL(cardUrl);
    cardUrl = URL.createObjectURL(cardBlob);
    const img = game.querySelector<HTMLImageElement>('.card-img');
    if (img) { img.src = cardUrl; img.alt = `Your result card. ${altText(e)}`; }
    const file = new File([cardBlob], 'my-ux-designers-choice-result.png', { type: 'image/png' });
    const sh = game.querySelector<HTMLElement>('[data-share]');
    if (sh && navigator.canShare?.({ files: [file] })) sh.hidden = false;
  };

  const START: Stats = { money: 20, inclusion: 5, career: 5 };
  const KEY = 'story-ux';
  type State = { step: number; phase: 'choose' | 'result' | 'later' | 'end'; later: number; stats: Stats; picks: number[] };
  const fresh = (): State => ({ step: 0, phase: 'choose', later: 0, stats: { ...START }, picks: [] });
  const read = (): State | null => { try { const s = JSON.parse(sessionStorage.getItem(KEY) || 'null'); return s && s.stats && 'inclusion' in s.stats ? s : null; } catch { return null; } };
  const save = (s: State | null) => { try { s ? sessionStorage.setItem(KEY, JSON.stringify(s)) : sessionStorage.removeItem(KEY); } catch {} };

  const intro = document.querySelector<HTMLElement>('[data-screen="intro"]')!;
  const play = document.querySelector<HTMLElement>('.play')!;
  const game = document.querySelector<HTMLElement>('[data-screen="game"]')!;
  const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const minus = (n: number) => (n < 0 ? '−' : '');
  const money = (n: number) => `${minus(n)}$${Math.abs(n)}k`;
  const num = (n: number) => `${minus(n)}${Math.abs(n)}`;
  const sign = (n: number) => (n > 0 ? '+' : '−') + Math.abs(n);
  const fxText = (fx: Fx) => [
    fx.money ? `Money ${fx.money > 0 ? '+' : '−'}$${Math.abs(fx.money)}k` : '',
    fx.inclusion ? `Inclusion ${sign(fx.inclusion)}` : '',
    fx.career ? `Career ${sign(fx.career)}` : '',
  ].filter(Boolean).join(', ') || 'No change';
  const apply = (s: State, fx: Fx) => {
    s.stats.money += fx.money || 0;
    s.stats.inclusion = Math.max(0, s.stats.inclusion + (fx.inclusion || 0));
    s.stats.career += fx.career || 0;
  };
  const totals = (s: State) => `You now have ${money(s.stats.money)}, ${num(s.stats.inclusion)} inclusion ${Math.abs(s.stats.inclusion) === 1 ? 'point' : 'points'} and ${num(s.stats.career)} career ${Math.abs(s.stats.career) === 1 ? 'point' : 'points'}.`;
  // one polite status line: what changed and where the stats stand (spoken after the new heading)
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const say = (text: string) => { status.textContent = ''; setTimeout(() => { status.textContent = text; }, 400); };
  const link = (issue: number, anchor: string, label: string) => `<a href="/notes/${issue}/#${anchor}">Read it in ${label}</a>`;

  function showStats(s: State) {
    (document.querySelector('[data-stat="money"]') as HTMLElement).textContent = money(s.stats.money);
    (document.querySelector('[data-stat="inclusion"]') as HTMLElement).textContent = num(s.stats.inclusion);
    (document.querySelector('[data-stat="career"]') as HTMLElement).textContent = num(s.stats.career);
  }

  function render(s: State, focus = true) {
    intro.hidden = true; play.hidden = false; showStats(s);
    let html = '';
    if (s.phase === 'choose') {
      const st = STEPS[s.step];
      html = `<p class="count" aria-hidden="true">Decision ${s.step + 1} of ${STEPS.length}</p><h2 tabindex="-1"><span class="visually-hidden">Decision ${s.step + 1} of ${STEPS.length}: </span>${esc(st.title)}</h2>
        <div class="scene"><img class="sfig" src="/images/figures/${st.fig}.svg" alt="" /><p>${esc(st.scene(s.picks))}</p></div>
        <div class="choices">${st.choices.map((c, i) => `<button type="button" class="choice" data-pick="${i}">${esc(c.label)}</button>`).join('')}</div>`;
    } else if (s.phase === 'result') {
      const st = STEPS[s.step], c = st.choices[s.picks[s.step]], r = resultOf(s.picks, s.step);
      html = `<p class="count" aria-hidden="true">Decision ${s.step + 1} of ${STEPS.length}</p><h2 tabindex="-1">You chose: ${esc(c.label)}</h2><p>${esc(r.text)}</p>
        <p class="fx">${esc(fxText(r.fx))}</p>
        <aside class="why"><h3>Why?</h3><p>${esc(c.access ? st.why.access : st.why.shortcut)}</p><p>${link(st.why.issue, st.why.anchor, st.why.label)}</p></aside>
        <button type="button" class="btn" data-next>${s.step + 1 < STEPS.length ? 'Next decision' : 'Six weeks later…'}</button>`;
    } else if (s.phase === 'later') {
      const screens = laterScreens(s.picks), ev = screens[s.later];
      html = `<p class="count" aria-hidden="true">Six weeks later</p><h2 tabindex="-1"><span class="visually-hidden">Six weeks later: </span>${esc(ev.title)}</h2><p>${esc(ev.text)}</p>
        <p class="fx">${esc(fxText(ev.fx))}</p>
        ${ev.like ? `<aside class="why"><h3>Like this case</h3><p>${esc(ev.like.text)}</p><p>${link(ev.like.issue, ev.like.anchor, ev.like.label)}</p></aside>` : ''}
        <button type="button" class="btn" data-next>${s.later + 1 < screens.length ? 'Continue' : 'See how your story ends'}</button>`;
    } else {
      const e = ending(s);
      const { money: m, inclusion: inc, career: car } = s.stats;
      html = `<h2 tabindex="-1">The end: ${e.title}</h2>
        <div class="scene"><img class="sfig" src="/images/figures/${e.fig}.svg" alt="" /><p>${e.text}</p></div>
        <p class="score">Your score: ${num(m)} + ${num(inc)} × ${num(car)} = <strong>${num(e.score)}</strong></p>
        <p class="small">Score = Money + Inclusion × Career. You chose accessibility in ${e.acc} of ${STEPS.length} decisions.</p>
        <section class="share" aria-labelledby="share-title">
          <h3 id="share-title">Share your result</h3>
          <img class="card-img" alt="" width="1080" height="1080" />
          <div class="share-btns">
            <button type="button" class="btn" data-download>Download image</button>
            <button type="button" class="choice" data-share hidden>Share</button>
            <button type="button" class="choice" data-copy>Copy alt text</button>
          </div>
          <p class="small">When you share the image, paste the alt text into its image description.</p>
          <p class="small"><strong>Alt text:</strong> ${esc(altText(e))}</p>
        </section>
        <div class="choices end"><a class="btn" href="/take-action/">Take action as a designer</a><button type="button" class="choice" data-restart>Play again</button></div>`;
    }
    game.innerHTML = html;
    if (s.phase === 'end') showCard(s);
    if (!focus) return;
    (game.querySelector('h2') as HTMLElement).focus();
    if (s.phase === 'choose') say(s.step === 0 ? `The story has started. ${totals(s)}` : `Your last choice: ${fxText(resultOf(s.picks, s.step - 1).fx)}. ${totals(s)}`);
    else if (s.phase === 'result') say(`${fxText(resultOf(s.picks, s.step).fx)}. ${totals(s)}`);
    else if (s.phase === 'later') say(`${fxText(laterScreens(s.picks)[s.later].fx)}. ${totals(s)}`);
    else say(`Your score is ${num(ending(s).score)}. You can share your result below.`);
  }

  // Coming back with the Back button (e.g. from a "Why?" link) or a reload: carry on where the reader was.
  // Any other visit starts at the introduction; a story still in progress can be continued from there.
  // A finished story is not kept: the next visit is a fresh start.
  const continueBtn = document.querySelector<HTMLButtonElement>('[data-continue]')!;
  const showIntro = (focus = false) => {
    play.hidden = true; intro.hidden = false; game.innerHTML = '';
    continueBtn.hidden = !state;
    if (focus) (document.querySelector('.game h1') as HTMLElement).focus();
  };
  const navType = (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type;
  let state = read();
  if (state && state.phase === 'end') { state = null; save(null); }
  if (state && (navType === 'back_forward' || navType === 'reload')) render(state, false);
  else showIntro();

  document.querySelector('[data-start]')!.addEventListener('click', () => { state = fresh(); save(state); render(state); });
  continueBtn.addEventListener('click', () => { if (state) render(state); });

  game.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('button');
    if (!t || !state) return;
    if (t.hasAttribute('data-download') && cardUrl) {
      const a = document.createElement('a'); a.href = cardUrl; a.download = 'my-ux-designers-choice-result.png'; a.click();
      say('Your result card is downloading.'); return;
    }
    if (t.hasAttribute('data-share') && cardBlob) {
      const file = new File([cardBlob], 'my-ux-designers-choice-result.png', { type: 'image/png' });
      navigator.share({ files: [file], text: altText(ending(state)) }).catch(() => {}); return;
    }
    if (t.hasAttribute('data-copy')) {
      navigator.clipboard.writeText(altText(ending(state))).then(() => say('Alt text copied.'), () => say('Copying failed. Select the alt text below and copy it.')); return;
    }
    if (t.dataset.pick) {
      state.picks[state.step] = Number(t.dataset.pick);
      apply(state, resultOf(state.picks, state.step).fx);
      state.phase = 'result';
    } else if (t.hasAttribute('data-next')) {
      if (state.phase === 'result' && state.step + 1 < STEPS.length) { state.step++; state.phase = 'choose'; }
      else if (state.phase === 'result') { state.phase = 'later'; state.later = 0; apply(state, laterScreens(state.picks)[0].fx); }
      else if (state.phase === 'later' && state.later + 1 < laterScreens(state.picks).length) { state.later++; apply(state, laterScreens(state.picks)[state.later].fx); }
      else state.phase = 'end';
    } else if (t.hasAttribute('data-restart')) {
      state = null; save(null); showIntro(true); say('Back to the start of the story.'); return;
    }
    save(state); render(state);
  });
</script>

