---
// Interactive story: five decisions of a UX designer. Every choice changes three stats and links to the
// piece of the archive behind it. One delayed consequence comes after the five decisions.
// Progress lives in this tab only (sessionStorage), so a reader can open a "Why?" link and come back.
// Accessibility: real buttons, stats as text, every change written out in words, focus moves to each new
// heading (so screen readers read it), no timers and no animation.
import Base from '../../layouts/Base.astro';
---
<Base title="Five Decisions: A UX Designer's Story" description="An interactive story. You are a UX designer at an online shop: make five decisions and see what they cost you, today and later.">
  <div class="wrap page reading">
    <div class="sheet story">
      <h1>Five Decisions: A UX Designer's Story</h1>

      <noscript><p>This story needs JavaScript to play.</p></noscript>

      <div class="screen" data-screen="intro">
        <img class="fig" src="/images/figures/role-design.svg" alt="" width="220" height="220" />
        <p>You are the only UX designer at a growing online shop. You start with <strong>$100</strong>, <strong>10 respect points</strong> and <strong>10 career points</strong>.</p>
        <p>Make five decisions. Every decision has a price. Some prices come later.</p>
        <button type="button" class="btn" data-start>Start the story</button>
      </div>

      <div class="play" hidden>
        <h2 class="visually-hidden">Your stats</h2>
        <dl class="stats">
          <div><dt>Money</dt><dd data-stat="money">$100</dd></div>
          <div><dt>Respect</dt><dd data-stat="respect">10</dd></div>
          <div><dt>Career</dt><dd data-stat="career">10</dd></div>
        </dl>
        <div class="screen" data-screen="game"></div>
      </div>
    </div>
  </div>
</Base>

<script>
  type Fx = { money?: number; respect?: number; career?: number };
  type Choice = { label: string; fx: Fx; result: string; access: boolean };
  type Why = { issue: number; anchor: string; text: string };
  type Step = { title: string; text: string; choices: [Choice, Choice]; why: Why };

  const STEPS: Step[] = [
    {
      title: 'The Black Friday banner',
      text: 'Marketing wants “Black Friday: 50% off” written on top of a busy product photo. They need it by tomorrow.',
      choices: [
        { label: 'Put the text on the photo', fx: { career: 2, respect: -1 }, access: false,
          result: 'Marketing loves it. But for partially sighted shoppers, the sale disappears into the photo.' },
        { label: 'Put the text on a plain background next to the photo', fx: { money: -10, career: -1, respect: 2 }, access: true,
          result: 'Marketing calls it “a bit boring” and you pay for an extra photo edit. But everyone can read the sale.' },
      ],
      why: { issue: 29, anchor: 'inspiration-2', text: 'As a partially sighted person, text on images is one of my biggest challenges. My simplest advice: use text on a plain background.' },
    },
    {
      title: 'The ugly focus outline',
      text: 'A developer says the focus outline looks ugly on the new buttons. “Can I just remove it?”',
      choices: [
        { label: 'Keep it, and design a better-looking one', fx: { money: -10, respect: 2 }, access: true,
          result: 'It takes you an afternoon, but the new outline looks good and everyone can see where they are.' },
        { label: 'Sure, remove it', fx: { career: 1, respect: -2 }, access: false,
          result: 'The buttons look cleaner. Keyboard users now lose track of where they are on the page.' }
      ],
      why: { issue: 5, anchor: 'inspiration-1', text: 'Keyboard users need to see where they are on the page. Pope Tech’s guide to accessible focus indicators shows how, and its “Common Pitfalls” section is the most useful part.' },
    },
    {
      title: 'The new homepage',
      text: 'The CEO wants a new homepage by Monday. An AI tool can generate one in minutes: a carousel, two pop-ups and three banners.',
      choices: [
        { label: 'Generate it and ship it', fx: { money: 10, career: 2, respect: -1 }, access: false,
          result: 'The CEO is impressed by your speed. The page is loud, crowded and hard to follow.' },
        { label: 'Simplify it and run the 75-year-old test', fx: { career: -1, respect: 2 }, access: true,
          result: 'You miss Monday by a day. The page is calm, and a 75-year-old with low vision could use it.' },
      ],
      why: { issue: 8, anchor: 'inspiration-1', text: 'The average homepage now has 1,437 elements, 22.5% more than the year before. Every UX designer should ask: can a 75-year-old with low vision use this site successfully?' },
    },
    {
      title: 'The checkout',
      text: 'The product manager wants a pre-ticked “Add insurance” box at checkout, and a cancellation process that takes five screens. Sales would go up.',
      choices: [
        { label: 'Push back and propose an honest checkout', fx: { career: -2, respect: 3 }, access: true,
          result: 'The product manager is not happy. Customers can see what they are buying and cancel easily.' },
        { label: 'Design it', fx: { money: 20, career: 3, respect: -3 }, access: false,
          result: 'Sales go up and you get a bonus. Some customers buy insurance they never wanted.' }
      ],
      why: { issue: 32, anchor: 'inspiration-2', text: 'No WCAG success criterion prevents dark patterns like misleading checkboxes or painful cancellation processes. Yet they can block people with cognitive disabilities or attention issues, or make them take actions they never wanted.' },
    },
    {
      title: 'Dark mode',
      text: 'Users keep asking for dark mode. You could invert all the colours and launch it today.',
      choices: [
        { label: 'Invert the colours and launch', fx: { career: 1, respect: -1 }, access: false,
          result: 'Dark mode is live in a day. Some icons vanish and some text is hard to read.' },
        { label: 'Go through a dark mode checklist first', fx: { money: -10, respect: 2 }, access: true,
          result: 'It takes a week, but dark mode works for everyone who turns it on.' },
      ],
      why: { issue: 31, anchor: 'inspiration-3', text: 'Russ Weakley’s dark mode checklist helps designers and developers: just answer “Yes” or “No” to each question.' },
    },
  ];

  const LATER_BAD = { title: 'Six weeks later: a letter', fx: { money: -60, career: -4 } as Fx,
    text: 'A letter arrives from a law firm. A blind customer couldn’t finish checkout on your shop. The company settles, and your manager asks why nobody checked.' };
  const LATER_GOOD = { title: 'Six weeks later: an email', fx: { money: 20, respect: 3 } as Fx,
    text: 'A customer writes: “I’m blind, and yours is the first shop where I could check out by myself.” She tells her friends, and sales go up.' };
  const LATER_WHY: Why = { issue: 29, anchor: 'news-3', text: 'Candycopia, a small candy shop, faced a five-figure settlement over its website’s ADA compliance. It had relied on third-party apps and a developer, and hadn’t invested much in its online presence.' };

  const START = { money: 100, respect: 10, career: 10 };
  const KEY = 'story-ux';
  type State = { step: number; phase: 'choose' | 'result' | 'later' | 'end'; stats: typeof START; picks: number[] };
  const read = (): State | null => { try { return JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch { return null; } };
  const save = (s: State | null) => { try { s ? sessionStorage.setItem(KEY, JSON.stringify(s)) : sessionStorage.removeItem(KEY); } catch {} };

  const intro = document.querySelector<HTMLElement>('[data-screen="intro"]')!;
  const play = document.querySelector<HTMLElement>('.play')!;
  const game = document.querySelector<HTMLElement>('[data-screen="game"]')!;
  const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const money = (n: number) => (n < 0 ? '−$' : '$') + Math.abs(n);
  const sign = (n: number) => (n > 0 ? '+' : '−') + Math.abs(n);
  const fxText = (fx: Fx) => [
    fx.money ? `Money ${fx.money > 0 ? '+' : '−'}$${Math.abs(fx.money)}` : '',
    fx.respect ? `Respect ${sign(fx.respect)}` : '',
    fx.career ? `Career ${sign(fx.career)}` : '',
  ].filter(Boolean).join(', ');
  const apply = (s: State, fx: Fx) => { s.stats.money += fx.money || 0; s.stats.respect += fx.respect || 0; s.stats.career += fx.career || 0; };
  const whyHtml = (w: Why) => `<aside class="why"><h3>Why?</h3><p>${esc(w.text)}</p><p><a href="/notes/${w.issue}/#${w.anchor}">Read it in Notes # ${w.issue}</a></p></aside>`;
  const shortcuts = (s: State) => s.picks.filter((p, i) => !STEPS[i].choices[p].access).length;

  function showStats(s: State) {
    (document.querySelector('[data-stat="money"]') as HTMLElement).textContent = money(s.stats.money);
    (document.querySelector('[data-stat="respect"]') as HTMLElement).textContent = String(s.stats.respect);
    (document.querySelector('[data-stat="career"]') as HTMLElement).textContent = String(s.stats.career);
  }

  function render(s: State, focus = true) {
    intro.hidden = true; play.hidden = false; showStats(s);
    let html = '';
    if (s.phase === 'choose') {
      const st = STEPS[s.step];
      html = `<p class="count">Decision ${s.step + 1} of ${STEPS.length}</p><h2 tabindex="-1">${esc(st.title)}</h2><p>${esc(st.text)}</p>
        <div class="choices">${st.choices.map((c, i) => `<button type="button" class="choice" data-pick="${i}">${esc(c.label)}</button>`).join('')}</div>`;
    } else if (s.phase === 'result') {
      const st = STEPS[s.step], c = st.choices[s.picks[s.step]];
      html = `<p class="count">Decision ${s.step + 1} of ${STEPS.length}</p><h2 tabindex="-1">You chose: ${esc(c.label)}</h2><p>${esc(c.result)}</p>
        <p class="fx">${esc(fxText(c.fx))}</p>${whyHtml(st.why)}
        <button type="button" class="btn" data-next>${s.step + 1 < STEPS.length ? 'Next decision' : 'Continue'}</button>`;
    } else if (s.phase === 'later') {
      const ev = shortcuts(s) >= 3 ? LATER_BAD : LATER_GOOD;
      html = `<h2 tabindex="-1">${esc(ev.title)}</h2><p>${esc(ev.text)}</p><p class="fx">${esc(fxText(ev.fx))}</p>${whyHtml(LATER_WHY)}
        <button type="button" class="btn" data-next>See how your story ends</button>`;
    } else {
      const n = shortcuts(s);
      const [title, text] = n === 0
        ? ['Accessibility champion', 'Your career moved slowly, but people trust your work. Disabled customers can shop on their own, and they come back.']
        : n < 3
        ? ['A thoughtful designer', 'You cut a few corners, but you cared when it mattered. Next time, maybe one more push back?']
        : ['Fast climber, hard landing', 'You climbed fast, but the shortcuts caught up with you. Accessibility debt always sends the bill later.'];
      html = `<h2 tabindex="-1">The end: ${title}</h2><p>${text}</p>
        <p>You finished with ${money(s.stats.money)}, ${s.stats.respect} respect points and ${s.stats.career} career points. You chose accessibility in ${STEPS.length - n} of ${STEPS.length} decisions.</p>
        <div class="choices"><a class="btn" href="/take-action/">Take action as a designer</a><button type="button" class="choice" data-restart>Play again</button></div>`;
    }
    game.innerHTML = html;
    if (focus) (game.querySelector('h2') as HTMLElement).focus();
  }

  let state = read();
  if (state) render(state, false);

  document.querySelector('[data-start]')!.addEventListener('click', () => {
    state = { step: 0, phase: 'choose', stats: { ...START }, picks: [] };
    save(state); render(state);
  });

  game.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('button');
    if (!t || !state) return;
    if (t.dataset.pick) {
      const i = Number(t.dataset.pick);
      state.picks[state.step] = i; apply(state, STEPS[state.step].choices[i].fx); state.phase = 'result';
    } else if (t.hasAttribute('data-next')) {
      if (state.phase === 'result' && state.step + 1 < STEPS.length) { state.step++; state.phase = 'choose'; }
      else if (state.phase === 'result') { state.phase = 'later'; apply(state, shortcuts(state) >= 3 ? LATER_BAD.fx : LATER_GOOD.fx); }
      else state.phase = 'end';
    } else if (t.hasAttribute('data-restart')) {
      state = { step: 0, phase: 'choose', stats: { ...START }, picks: [] };
    }
    save(state); render(state);
  });
</script>

<style is:global>
  .page { padding-top: 2.5rem; }
  .story h2 { margin-top: 0.75rem; }
  .story h2:focus { outline: none; }
  .story h2:focus-visible { outline: 3px solid var(--notebook); outline-offset: 4px; }
  .story .fig { display: block; width: 11rem; height: auto; margin: 0 0 1rem; }
  .story .stats { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: 0 0 1.25rem; padding: 0.75rem 1rem; border: 2px solid var(--notebook); border-radius: 8px; }
  .story .stats div { display: flex; gap: 0.4rem; align-items: baseline; }
  .story .stats dt { font-weight: 700; }
  .story .stats dt::after { content: ':'; }
  .story .stats dd { margin: 0; font-weight: 800; font-variant-numeric: tabular-nums; }
  .story .count { margin: 0; font-size: 0.85rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
  .story .choices { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1.25rem; }
  .story .choice, .story .btn { min-height: 44px; padding: 0.6rem 1rem; border-radius: 6px; font: inherit; font-weight: 800; text-align: left; cursor: pointer; text-decoration: none; }
  .story .choice { background: #fff; color: var(--notebook); border: 2px solid var(--notebook); }
  .story .btn { display: inline-flex; align-items: center; justify-content: center; margin-top: 1rem; background: var(--notebook); color: #fff; border: 2px solid var(--notebook); }
  .story .choices .btn { margin-top: 0; }
  .story .choice:hover { background: #f1ebfb; }
  .story .btn:hover { background: #fff; color: var(--notebook); }
  .story .choice:focus-visible, .story .btn:focus-visible { outline: 3px solid var(--notebook); outline-offset: 3px; }
  .story .fx { font-weight: 800; }
  .story .why { margin-top: 1.25rem; padding: 0.75rem 1rem; border-left: 4px solid var(--notebook); background: #f6f2fd; }
  .story .why h3 { margin: 0 0 0.25rem; font-size: 1rem; }
  .story .why p { margin: 0.25rem 0; }
  @media (forced-colors: active) { .story .why { border-left-color: CanvasText; background: Canvas; } .story .stats { border-color: CanvasText; } }
</style>
